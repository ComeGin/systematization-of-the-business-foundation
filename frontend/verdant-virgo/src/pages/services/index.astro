---
// 画面 2 サービス一覧（/services）。01-content-spec.md §4.2。Figma は Services / Desktop 1440（46:8030）・Mobile 390（46:8876）。
// ページは組み立てだけ。文言は site-content/services.ts（料金は pricing.ts）、部品は layout・marketing-ui・forms から読む。
// 短い文が並ぶセクションには phrase（文節で折り返す）を付ける（H-18。トップと同じ）。
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { BaseLayout, PageIntro } from '@/modules/layout';
import { CTABanner, CTAButton, IconCard, Section, SectionHeading, ServiceCard, Steps } from '@/modules/marketing-ui';
import { TAX_NOTE } from '@/modules/site-content/pricing';
import { detailLinkTarget } from '@/modules/site-content/a11y';
import { SEO } from '@/modules/site-content/seo';
import {
  ctaHref,
  SERVICE_CARDS,
  SERVICE_ORDER,
  SERVICES_INDEX,
  serviceCardPrices,
} from '@/modules/site-content/services';

const seo = SEO.services;
const from = Astro.url.pathname;
const { h1, breadcrumb, intro, cards, chooser, flow, banner } = SERVICES_INDEX;

// 2-4 のサービスカード。金額・期間・備考は §2（pricing.ts）から引く
const serviceCards = SERVICE_ORDER.map((slug) => ({ card: SERVICE_CARDS[slug], ...serviceCardPrices(SERVICE_CARDS[slug]) }));
---

<BaseLayout title={seo.title} description={seo.description} noindex={seo.noindex} breadcrumb={breadcrumb.slice(1)}>
  {/* 2-3 導入ヒーロー（ボタンなし。主 CTA はページ下部に集める） */}
  <PageIntro title={h1} body={intro.join('')} />

  {/* 2-4 サービスカード（Desktop 2×2、Mobile 1 列）。見出しの上に h2 が無いので、カードの見出しを h2 にする（見た目は変えない。1.3.1） */}
  <Section class="phrase">
    <div class="grid gap-4 md:grid-cols-2 md:gap-6">
      {
        serviceCards.map(({ card, prices, note }) => (
          <ServiceCard
            level="h2"
            title={card.title}
            badge={card.badge ?? undefined}
            body={card.body}
            prices={prices}
            note={note}
            detailHref={card.detailLink.href}
            detailLabel={card.detailLink.label}
            detailTarget={detailLinkTarget(card.title)}
          >
            {card.sourceDlLinkLabel && (
              <CTAButton slot="sub-link" ctaId={cards.sourceDlCtaId} href="/#source-dl" variant="link" icon="download">
                {card.sourceDlLinkLabel}
              </CTAButton>
            )}
          </ServiceCard>
        ))
      }
    </div>
    <p class="type-small mt-8 text-text-muted md:mt-12">{TAX_NOTE}</p>
  </Section>

  {/* 2-5 どれを選べばよいか（Desktop は表、Mobile は行ごとのカードで「おすすめ：」を前置） */}
  <Section labelledby="services-chooser" class="phrase">
    <SectionHeading id="services-chooser" title={chooser.heading} />
    <div class="mt-8 hidden md:mt-12 md:block">
      <Table>
        <TableHeader>
          <TableRow className="border-border hover:bg-transparent">
            <TableHead className="type-label h-9 w-[672px] px-2 text-text-body">{chooser.columns[0]}</TableHead>
            <TableHead className="type-label h-9 px-2 text-text-body">{chooser.columns[1]}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {
            chooser.rows.map((row) => (
              <TableRow className="border-border bg-surface-subtle hover:bg-surface-subtle">
                <TableCell className="type-body px-2 py-2 whitespace-normal text-text-body">{row.situation}</TableCell>
                <TableCell className="type-body px-2 py-2 whitespace-normal text-text-body">{row.recommend}</TableCell>
              </TableRow>
            ))
          }
        </TableBody>
      </Table>
    </div>
    <ul class="mt-8 flex flex-col gap-4 md:hidden">
      {
        chooser.rows.map((row) => (
          <li>
            <IconCard title={row.situation}>
              <p slot="body" class="type-small text-text-muted">
                {chooser.mobileRecommendPrefix}
                {row.recommend}
              </p>
            </IconCard>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* 2-6 ご利用の流れ（Desktop 3 列 ＋ 2 列、Mobile 縦 1 列） */}
  <Section labelledby="services-flow" class="phrase">
    <SectionHeading id="services-flow" title={flow.heading} />
    <Steps items={[...flow.items]} columns={3} class="mt-8 md:mt-12" />
  </Section>

  {/* 2-8 CTA バナー（主 CTA） */}
  <Section>
    <CTABanner title={banner.title} body={banner.body}>
      <CTAButton slot="cta" ctaId={banner.cta.ctaId} href={ctaHref(banner.cta, from)} size="lg" fullWidth="mobile">
        {banner.cta.label}
      </CTAButton>
    </CTABanner>
  </Section>
</BaseLayout>
