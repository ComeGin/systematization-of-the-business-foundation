---
// 画面 4 料金（/pricing）。01-content-spec.md §4.4（料金の正本は §2）。Figma は Pricing / Desktop 1440（44:6574）・Mobile 390（46:486）。
// ページは組み立てだけ。料金と文言は site-content/pricing.ts、無料 DL ブロックの文言は services.ts の中立版（2-7）から読む。
// 短い文が並ぶセクションには phrase（文節で折り返す）を付ける（H-18。トップと同じ）。
import { Table, TableBody, TableCell, TableHead, TableHeader, TableRow } from '@/components/ui/table';
import { SourceDownloadBlock } from '@/modules/forms';
import { BaseLayout, PageIntro } from '@/modules/layout';
import { CTABanner, CTAButton, FAQItem, IconCard, PricingCard, Section, SectionHeading } from '@/modules/marketing-ui';
import { PRICING, PRICING_DESCRIPTIONS, PRICING_PAGE, PRICING_ROWS, TAX_NOTE } from '@/modules/site-content/pricing';
import { SEO } from '@/modules/site-content/seo';
import { ctaHref, SOURCE_DL_NEUTRAL, SOURCE_DL_NEUTRAL_KEEP_TOGETHER, type CtaCopy } from '@/modules/site-content/services';

const seo = SEO.pricing;
const from = Astro.url.pathname;
const { h1, breadcrumb, intro, cards, table, paymentAndContract, sourceDlCtaId, faq, banner } = PRICING_PAGE;
const { payment, contract } = paymentAndContract;

// 料金カード 5 枚。主ボタンは /contact?service=<プロダクト>。同じ cta_id（consult_pricing_card）を 5 枚で使うので service で内訳を分ける（§6.3）
const pricingCards = cards.items.map((item) => {
  const cta: CtaCopy = { label: item.cta.label, ctaId: item.cta.ctaId, target: { type: 'contact', service: item.key } };
  return { item, row: PRICING[item.key], description: PRICING_DESCRIPTIONS[item.key], cta };
});
const upperCards = pricingCards.slice(0, 3);
const lowerCards = pricingCards.slice(3);

const bannerCta: CtaCopy = { label: banner.cta.label, ctaId: banner.cta.ctaId, target: { type: 'contact' } };

// 表のセル（Figma: 見出し行は Label 14px・地なし、本文の行は Body 16px・地 surface-subtle・下罫線）
const headCell = 'type-label h-9 px-2 text-text-body';
const bodyRow = 'border-border bg-surface-subtle hover:bg-surface-subtle';
const bodyCell = 'type-body px-2 py-2 align-middle whitespace-normal text-text-body';
// お支払いの表は Mobile でも表のまま出すので、Mobile だけ Small 14px（Figma 46:7540）
const paymentCell = 'type-small md:type-body px-2 py-2 align-middle whitespace-normal text-text-body';
---

<BaseLayout title={seo.title} description={seo.description} noindex={seo.noindex} breadcrumb={breadcrumb.slice(1)} sourceDlOnPage>
  {/* 4-3 導入ヒーロー（ボタンなし） */}
  <PageIntro title={h1} body={intro.join('')} />

  {/* 4-4 料金カード（Desktop は 3 列 ＋ 2 列、Mobile は 1 列） */}
  <Section class="phrase">
    <div class="flex flex-col gap-4 md:gap-6">
      {
        [upperCards, lowerCards].map((group, i) => (
          <div class:list={['grid gap-4 md:gap-6', i === 0 ? 'md:grid-cols-3' : 'md:grid-cols-2']}>
            {group.map(({ item, row, description, cta }) => (
              <PricingCard
                product={row.product}
                badge={item.badge ?? undefined}
                description={description}
                price={row.price}
                period={row.period}
                note={row.note ?? undefined}
              >
                <CTAButton slot="cta" ctaId={cta.ctaId} href={ctaHref(cta, from)} service={item.key} fullWidth>
                  {cta.label}
                </CTAButton>
                {item.sourceDlLink && (
                  <CTAButton slot="sub-link" ctaId={item.sourceDlLink.ctaId} href="#source-dl" variant="link" icon="download">
                    {item.sourceDlLink.label}
                  </CTAButton>
                )}
              </PricingCard>
            ))}
          </div>
        ))
      }
    </div>
    <p class="type-small mt-6 text-text-muted">{TAX_NOTE}</p>
  </Section>

  {/* 4-5 料金一覧表（Desktop だけ。Mobile はカードが一覧の役割を担う） */}
  <Section labelledby="pricing-table" class="hidden md:block">
    <SectionHeading id="pricing-table" title={table.heading} />
    <div class="mt-12">
      <Table>
        <TableHeader>
          <TableRow className="border-border hover:bg-transparent">
            <TableHead className={`${headCell} w-[384px]`}>{table.columns[0]}</TableHead>
            <TableHead className={`${headCell} w-[224px]`}>{table.columns[1]}</TableHead>
            <TableHead className={`${headCell} w-[192px]`}>{table.columns[2]}</TableHead>
            <TableHead className={headCell}>{table.columns[3]}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {
            PRICING_ROWS.map((row) => (
              <TableRow className={bodyRow}>
                <TableCell className={bodyCell}>{row.product}</TableCell>
                <TableCell className={bodyCell}>{row.price}</TableCell>
                <TableCell className={bodyCell}>{row.period}</TableCell>
                <TableCell className={bodyCell}>{row.note ?? ''}</TableCell>
              </TableRow>
            ))
          }
        </TableBody>
      </Table>
    </div>
    <p class="type-small mt-12 text-text-muted">{TAX_NOTE}</p>
  </Section>

  {/* 4-6 お支払いと契約について */}
  <Section labelledby="pricing-payment" class="phrase">
    <SectionHeading id="pricing-payment" title={paymentAndContract.heading} />

    <h3 class="type-h3 mt-8 text-text-heading md:mt-12">{payment.heading}</h3>
    {/* お支払いの表は見出し行を持たない（Figma 46:7634）。Mobile も 2 列の表のまま */}
    <div class="mt-3 md:mt-4">
      <Table>
        <TableBody>
          {
            payment.rows.map(([label, value]) => (
              <TableRow className={bodyRow}>
                <TableHead scope="row" className={`${paymentCell} h-auto w-[152px] font-normal md:w-[320px]`}>
                  {label}
                </TableHead>
                <TableCell className={paymentCell}>{value}</TableCell>
              </TableRow>
            ))
          }
        </TableBody>
      </Table>
    </div>

    <h3 class="type-h3 mt-8 text-text-heading md:mt-12">{contract.heading}</h3>
    {/* Desktop は 4 列の表、Mobile は行ごとのカード（上にサービス名、下に「ラベル：値」を縦積み） */}
    <div class="mt-4 hidden md:block">
      <Table>
        <TableHeader>
          <TableRow className="border-border hover:bg-transparent">
            <TableHead className={`${headCell} w-[300px]`}>{contract.columns[0]}</TableHead>
            <TableHead className={`${headCell} w-[320px]`}>{contract.columns[1]}</TableHead>
            <TableHead className={`${headCell} w-[250px]`}>{contract.columns[2]}</TableHead>
            <TableHead className={headCell}>{contract.columns[3]}</TableHead>
          </TableRow>
        </TableHeader>
        <TableBody>
          {
            contract.rows.map((row) => (
              <TableRow className={bodyRow}>
                <TableCell className={bodyCell}>{PRICING[row.key].product}</TableCell>
                {row.cells.map((cell) => (
                  <TableCell className={bodyCell}>{cell}</TableCell>
                ))}
              </TableRow>
            ))
          }
        </TableBody>
      </Table>
    </div>
    <ul class="mt-3 flex flex-col gap-4 md:hidden">
      {
        contract.rows.map((row) => (
          <li>
            <IconCard title={PRICING[row.key].product}>
              <dl slot="body" class="type-body text-text-muted">
                {row.cells.map((cell, i) => (
                  <div>
                    <dt class="inline">{contract.columns[i + 1]}：</dt>
                    <dd class="inline">{cell}</dd>
                  </div>
                ))}
              </dl>
            </IconCard>
          </li>
        ))
      }
    </ul>

    <p class="type-small mt-8 text-text-muted md:mt-12">{TAX_NOTE}</p>
  </Section>

  {/* 4-7 無料 DL ブロック（控えめ版。2-7 の中立版と同じ文言。部品が id="source-dl" を持つ） */}
  <Section>
    <SourceDownloadBlock ctaId={sourceDlCtaId} emphasis="subtle" title={SOURCE_DL_NEUTRAL.title} body={SOURCE_DL_NEUTRAL.body} keepTogether={SOURCE_DL_NEUTRAL_KEEP_TOGETHER} />
  </Section>

  {/* 4-8 よくある質問（最初の 1 件だけ開く。回答に【要記入】を含む Q3 は「要記入」のマーカー） */}
  <Section labelledby="pricing-faq">
    <SectionHeading id="pricing-faq" title={faq.heading} />
    <div class="mt-8 md:mt-12">
      {faq.items.map((item, i) => <FAQItem question={item.question} answer={item.answer} open={i === 0} marker={item.marker} />)}
    </div>
  </Section>

  {/* 4-9 CTA バナー（主 CTA） */}
  <Section>
    <CTABanner title={banner.title} body={banner.body}>
      <CTAButton slot="cta" ctaId={bannerCta.ctaId} href={ctaHref(bannerCta, from)} size="lg" fullWidth="mobile">
        {bannerCta.label}
      </CTAButton>
    </CTABanner>
  </Section>
</BaseLayout>
