---
// 記事 1 本の BlogCard（ブログ一覧 7-4・記事の関連記事 8-9）。カバーがあれば取り込んだ画像、無ければ BlogCard の「画像（準備中）」の枠。
// slot="image" は中身が空でも「あり」と判定されるので、カバーの有無で BlogCard ごと出し分ける。
// ファイル名の先頭の _ でページにならない（Astro のルーティングの対象外）。
// 記事へ移るとき、カードの見出しと画像が記事の h1 とアイキャッチへ形を変える（BlogCard の morph。page-transition が名前を付ける）。
import { formatJstDate, StrapiImage, type Article } from '@/modules/blog';
import { BlogCard, type HeadingLevel } from '@/modules/marketing-ui';

interface Props {
  article: Article;
  /** alt が空のときの記録に使う（どこのカバーか） */
  context: string;
  /** カードの見出しの段。ブログ一覧は h1 の直下なので h2、関連記事は h2「関連する記事」の下なので h3 */
  level?: HeadingLevel;
}

const { article, context, level = 'h3' } = Astro.props;
const card = {
  href: `/blog/${article.slug}`,
  title: article.title,
  excerpt: article.description,
  date: formatJstDate(article.publishedAt),
  dateTime: article.publishedAt,
  category: article.category?.name,
  class: 'w-full',
  level,
  morph: true,
};
---

{
  article.cover ? (
    <BlogCard {...card}>
      <StrapiImage
        slot="image"
        media={article.cover}
        context={context}
        sizes="(min-width: 768px) 368px, 100vw"
        widths={[368, 736]}
        class="h-full w-full object-cover"
      />
    </BlogCard>
  ) : (
    <BlogCard {...card} />
  )
}
