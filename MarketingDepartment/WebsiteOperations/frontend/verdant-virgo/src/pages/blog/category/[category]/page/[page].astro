---
// 画面 7 ブログ一覧のカテゴリ別の 2 ページ目以降（/blog/category/<slug>/page/<n>）。
// SEO は §7 に無く、2026-10-09 にリードが決めた（title にカテゴリ名〈と何ページ目か〉を足す。description は一覧と同じ。index・canonical はページ自身）。
import type { GetStaticPaths } from 'astro';
import { BLOG_CATEGORIES, getArticlesByCategory, paginate, type Article } from '@/modules/blog';
import { blogCategorySeo } from '@/modules/site-content/seo';
import BlogListing from '../../../_BlogListing.astro';

export const getStaticPaths = (async () => {
  const paths = await Promise.all(
    BLOG_CATEGORIES.map(async (category) => {
      const pages = paginate(await getArticlesByCategory(category.slug));
      return pages.slice(1).map((articles, i) => ({
        params: { category: category.slug, page: String(i + 2) },
        props: { label: category.label, articles, page: i + 2, totalPages: pages.length },
      }));
    }),
  );
  return paths.flat();
}) satisfies GetStaticPaths;

interface Props {
  label: string;
  articles: Article[];
  page: number;
  totalPages: number;
}

const { category } = Astro.params;
const { label, articles, page, totalPages } = Astro.props;
---

<BlogListing seo={blogCategorySeo(label, page)} articles={articles} page={page} totalPages={totalPages} categorySlug={category} />
