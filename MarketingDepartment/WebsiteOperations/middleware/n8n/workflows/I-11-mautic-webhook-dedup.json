    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"status\":\"accepted\"}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "942d8488-93a5-5f23-839f-2e3770e3bbcc",
      "name": "200 を返す",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
