---
/**
 * セクション見出し（h2）＋ リード文（Figma の SectionHeading）。
 * Align=left ／ center（中央揃えのときリードは最大 768px、左揃えは 720px）。
 * 見出しの横のバッジ（「準備中」「要確認」など）は badge。見出しに改行位置の指定があるときは title に BreakableHeading を渡す（計画書 P-3）。
 * 既定値は持たない（title か slot="title" が必須。H-16）。
 */
import { Badge } from '@/components/ui/badge';
import { cn } from '@/lib/utils';
import type { BreakableHeading } from '../lib/heading';
import type { HeadingLevel } from '../lib/types';
import HeadingLines from './HeadingLines.astro';

interface Props {
  /** 改行位置の指定がある見出しは BreakableHeading で渡す（計画書 P-3） */
  title?: string | BreakableHeading;
  lead?: string;
  align?: 'left' | 'center';
  badge?: string;
  /** バッジの見た目。未決の印（要確認・要記入）は outline、ダミーの「準備中」は secondary */
  badgeVariant?: 'secondary' | 'outline';
  level?: HeadingLevel;
  /** 見出しの id（Section の labelledby に渡す） */
  id?: string;
  class?: string;
}

const { title, lead, align = 'left', badge, badgeVariant = 'secondary', level = 'h2', id, class: className } = Astro.props;
const hasTitleSlot = Astro.slots.has('title');
if (!title && !hasTitleSlot) {
  throw new Error('SectionHeading: title か slot="title" のどちらかを渡してください。');
}
const Heading = level;
const center = align === 'center';
---

<div class={cn('flex flex-col gap-3 md:gap-4', center ? 'items-center text-center' : 'items-start', className)}>
  <div class={cn('flex flex-wrap items-center gap-x-3 gap-y-2', center && 'justify-center')}>
    <Heading id={id} class="type-h2 text-text-heading">
      {hasTitleSlot ? <slot name="title" /> : typeof title === 'string' ? title : title && <HeadingLines heading={title} />}
    </Heading>
    {badge && <Badge variant={badgeVariant}>{badge}</Badge>}
  </div>
  {lead && <p class={cn('type-body-lg phrase text-text-muted', center ? 'max-w-[768px]' : 'max-w-[720px]')}>{lead}</p>}
  <slot name="lead" />
</div>
