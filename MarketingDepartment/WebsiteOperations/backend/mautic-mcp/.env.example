# Mautic（本サーバ → Mautic: OAuth2 client_credentials）
MAUTIC_BASE_URL=http://localhost:8000
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=

# 公開するツールの範囲
#   read_only  : 参照のみ（既定）
#   read_write : 作成・更新も（mautic_create_record / mautic_update_record）
#   full       : 削除も（mautic_delete_record）
MAUTIC_ACCESS_LEVEL=read_only

# トランスポート: http（既定）| stdio
TRANSPORT=http
HOST=127.0.0.1
# 3100 は Chatwoot 本体の既定と同じ。両方を動かすならどちらかを変える（使用中なら failed to listen を出して終了する）
PORT=3100

# MCP クライアント → 本サーバの Bearer トークン（HTTP のとき必須、32 文字以上）。stdio では空のままでよい（空は未設定と同じ）
# 生成例: openssl rand -hex 32
MCP_AUTH_TOKEN=

# HOST=0.0.0.0 などで公開する場合に許可するホスト名（カンマ区切り）。空は未設定と同じ
# MCP_ALLOWED_HOSTS=mcp.example.com
