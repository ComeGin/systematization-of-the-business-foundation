---
/**
 * 改行位置を指定した見出し（BreakableHeading を描く）。Desktop・Mobile で別の位置に <br> を出し分ける（md が境目）。
 * <br> は文字を持たないので、見出しの文字（スクリーンリーダー・検索エンジンが読むもの）は text と同じになる。
 * 文字の大きさと色は class で渡す（例 class="type-h1 text-text-heading"）。
 * SectionHeading・PageIntro の title にも BreakableHeading をそのまま渡せる。
 */
import type { BreakableHeading } from '../lib/heading';
import HeadingLines from './HeadingLines.astro';

interface Props {
  heading: BreakableHeading;
  level: 'h1' | 'h2' | 'h3';
  id?: string;
  class?: string;
}

const { heading, level, id, class: className } = Astro.props;
const Heading = level;
---

<Heading id={id} class={className}><HeadingLines heading={heading} /></Heading>
