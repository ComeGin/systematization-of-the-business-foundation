              "id": "detail",
              "name": "detail",
              "type": "string",
              "value": "={{ $json.count > 0 ? '最短の期限まで ' + $json.daysLeft + ' 日（' + $json.notAfter + '）' : '証明書を読めない（sandbox-tls の public マウントを確認する）' }}"
            }
          ]
        },
        "options": {}
      },
