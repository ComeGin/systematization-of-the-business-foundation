{
  "name": "n8n スケジュール実行のハートビート",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "minutes",
              "minutesInterval": 5
            }
          ]
        }
      },
      "id": "0c70d55c-8d8a-5788-ab05-c30387b3ab09",
      "name": "5 分ごと",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.4,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "ops_settings"
        },
        "returnAll": true
      },
      "id": "00b618e1-75ca-501c-a5bc-45081190729b",
      "name": "設定を読む",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        224,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict"
          },
          "conditions": [
            {
              "id": "ba1dda39-3dc1-5f26-a437-9b1e696a8e74",
              "leftValue": "={{ $('設定を読む').all().find(r => r.json.key === 'heartbeatEnabled')?.json.value ?? 'false' }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "true"
            }
          ],
          "combinator": "and"
        }
      },
      "id": "bf4bf169-23ad-5b69-a744-f91e9f35f4ba",
      "name": "ハートビートが有効か",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        0
      ],
      "notes": "ops_settings の heartbeatEnabled が true のときだけ動く。行が無い・true 以外なら何もしない（安全側）。",
      "executeOnce": true
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://monitoring.ap-northeast-1.amazonaws.com/",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "aws",
        "sendBody": true,
        "contentType": "form-urlencoded",
        "specifyBody": "keypair",
        "bodyParameters": {
          "parameters": [
            {
              "name": "Action",
              "value": "PutMetricData"
            },
            {
              "name": "Version",
              "value": "2010-08-01"
            },
            {
              "name": "Namespace",
              "value": "={{ $('設定を読む').all().find(r => r.json.key === 'heartbeatNamespace')?.json.value || 'ComeGin/OnpremN8n' }}"
            },
            {
              "name": "MetricData.member.1.MetricName",
              "value": "ScheduleHeartbeat"
            },
            {
              "name": "MetricData.member.1.Value",
              "value": "1"
            },
            {
              "name": "MetricData.member.1.Unit",
              "value": "Count"
            }
          ]
        },
        "options": {
          "timeout": 10000
        }
      },
      "id": "d72ae97c-b2e6-5aea-aaee-beb38315106c",
      "name": "CloudWatch に PutMetricData",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        0
      ],
      "notes": "CloudWatch の Query API（Version=2010-08-01）。本文は必ずフォーム形式で渡す（JSON オブジェクトだと資格情報が JSON.stringify して署名し、送る本文と食い違う）。サービスとリージョンは URL から導かれる。IAM は名前空間の条件つき（ComeGin/OnpremN8n）。",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "aws": {
          "name": "AWS SNS 発行（アクセスキー）"
        }
      }
    }
  ],
  "connections": {
    "5 分ごと": {
      "main": [
        [
          {
            "node": "設定を読む",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "設定を読む": {
      "main": [
        [
          {
            "node": "ハートビートが有効か",
            "type": "main",
            "index": 0
          }
        ]
      ]
    },
    "ハートビートが有効か": {
      "main": [
        [
          {
            "node": "CloudWatch に PutMetricData",
            "type": "main",
            "index": 0
          }
        ]
      ]
    }
  },
  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tokyo",
    "saveDataSuccessExecution": "none",
    "executionTimeout": 30
  },
  "pinData": {},
  "meta": {
    "description": "本番の n8n（オンプレ）の定期実行が生きていることを、5 分ごとに CloudWatch のカスタムメトリクス（ComeGin/OnpremN8n の ScheduleHeartbeat）で知らせる。途絶えたら CloudWatch のアラームが ops に通知する（TA-05 の項目 3）。ops_settings の heartbeatEnabled が true のときだけ動く。"
  }
}
