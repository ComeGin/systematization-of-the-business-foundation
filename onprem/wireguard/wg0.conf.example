# オンプレ側の WireGuard の設定（ADR-21）。/etc/wireguard/wg0.conf の雛形。
#
# このファイルに鍵は書かない。実際の設定は dev/render-conf.sh が、秘密鍵と EC2 の公開鍵・Elastic IP を入れて
# ~/.config/comegin/wireguard/wg0.conf（600）に作る。それを /etc/wireguard/wg0.conf に置く（README.md）。
#
# アドレスの取り決め: 10.99.0.0/24。EC2（VPC 側）が 10.99.0.1、オンプレ（このマシン）が 10.99.0.2。UDP 51820。
# オンプレから外向きに接続する（ListenPort は要らない。オンプレの IP が変わっても使える）。

[Interface]
Address = 10.99.0.2/32
PrivateKey = <ONPREM_PRIVATE_KEY>
# EC2 側（cloud/stacks/wireguard.yaml）と同じ値。自動に任せると EC2 側は ENI の 9001 から 8921 になり、
# 国内の回線のトンネル（PPPoE は 1454、IPv4 over IPv6〈DS-Lite・MAP-E〉は 1460）で外側の UDP が分割される。
# 1380 はどちらから WireGuard の 60 バイト（IPv4）を引いても収まる値
MTU = 1380

[Peer]
# EC2（VPC 側）の公開鍵。SSM パラメータから取り出す（README.md）
PublicKey = <EC2_PUBLIC_KEY>
# EC2 の Elastic IP と WireGuard のポート（親パラメータ WireguardPort の既定は 51820）
Endpoint = <EC2_ELASTIC_IP>:51820
# 10.20.0.0/16 は VPC の CIDR（cloud/template.yaml の VpcCidr の既定値。VpcCidr を変えた場合は合わせる）。
#   - オンプレ → AWS: この経路で RDS（5432）に届く
#   - AWS → オンプレ: クラウドの Mautic・Chatwoot の Webhook は、EC2 が masquerade するので送信元が 10.99.0.1 になって届く
#     （10.99.0.1/32 の許可で受け入れられる）。VPC の CIDR は、主に上の RDS 向けの経路のために要る
# 10.99.0.1/32 は EC2 自身（Webhook の送信元になるアドレス。疎通の確認にも使う）。
# EC2 側のピア（このマシン）の AllowedIPs は 10.99.0.2/32 だけ。EC2 から VPC への転送は RDS の 5432 だけを許す
AllowedIPs = 10.20.0.0/16, 10.99.0.1/32
# NAT・ファイアウォールの内側から接続を保つ（EC2 から Webhook を送り返せるようにする）
PersistentKeepalive = 25
