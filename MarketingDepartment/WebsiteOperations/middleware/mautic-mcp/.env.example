# Mautic（本サーバ → Mautic: OAuth2 client_credentials）
MAUTIC_BASE_URL=https://comegin-mautic-dev.ngrok.app
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=

# トランスポート: http（既定）| stdio
TRANSPORT=http
HOST=127.0.0.1
PORT=3100

# MCP クライアント → 本サーバの Bearer トークン（HTTP のとき必須、32 文字以上）
# 生成例: openssl rand -hex 32
MCP_AUTH_TOKEN=

# HOST=0.0.0.0 などで公開する場合に許可するホスト名（カンマ区切り）
# MCP_ALLOWED_HOSTS=mcp.example.com
