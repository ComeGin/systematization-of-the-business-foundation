---
// 画面 5 会社概要（/about）。01-content-spec.md §4.5。Figma は About / Desktop（45:2592）・About / Mobile（45:7683）。
// ページは組み立てだけ。文言は site-content/about.ts、部品は layout・marketing-ui・legal から読む。
// ヘッダー・パンくず・フッター・Cookie 同意バナー・チャットは BaseLayout が置く。
import { FileCheck, Footprints, LockOpen, MessagesSquare, type LucideIcon } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { isLink, RichTextView, toInlines, type RichText } from '@/modules/legal';
import { BaseLayout, PageIntro } from '@/modules/layout';
import { CTABanner, CTAButton, IconCard, ImagePlaceholder, KeepTogether, Section, SectionHeading } from '@/modules/marketing-ui';
import { about } from '@/modules/site-content/about';
import { contactHref } from '@/modules/site-content/cta';
import { SEO } from '@/modules/site-content/seo';

const seo = SEO.about;
const from = Astro.url.pathname;

// about.ts のアイコン名（Lucide の kebab-case）→ 部品
const ICONS: Record<string, LucideIcon> = {
  footprints: Footprints,
  'file-check': FileCheck,
  'messages-square': MessagesSquare,
  'lock-open': LockOpen,
};
const iconOf = (name: string) => {
  const icon = ICONS[name];
  if (!icon) throw new Error(`about.astro: アイコン「${name}」の対応がありません。`);
  return icon;
};

const { hero, values, career, selfOperation, company, members, ctaBanner } = about;
const hasLink = (value: RichText) => toInlines(value).some(isLink);
// 項目の列（Mobile 96px）で語の途中で折り返さない語（Figma は「メール／アドレス」で割っている）
const LABEL_KEEP_TOGETHER = ['メール', 'アドレス'];
// ホームはパンくずの部品が先頭に足す
const breadcrumb = about.breadcrumb.slice(1).map((crumb) => ({ ...crumb }));
---

<BaseLayout title={seo.title} description={seo.description} noindex={seo.noindex} breadcrumb={breadcrumb}>
  {/* 5-3 導入ヒーロー。h1 はビジョン（Desktop 2 行・Mobile 4 行。H-19）。画像枠は Desktop だけ */}
  <PageIntro title={hero.h1} badge={hero.badge}>
    <p slot="body" class="type-body-lg phrase max-w-[720px] text-text-muted">{hero.body.join('')}</p>
    <ImagePlaceholder slot="media" label={hero.imagePlaceholder} class="hidden h-[360px] w-full md:flex" />
  </PageIntro>

  {/* 5-3 の続き: ミッション（引用の体裁）と、ビジョンへつなぐ補足 2 文。地はヒーローと同じ */}
  <Section tone="subtle" class="phrase pt-0 md:pt-0" labelledby="about-mission">
    <div class="flex flex-col gap-4">
      <p id="about-mission" class="type-small text-text-brand">{hero.mission.label}</p>
      <blockquote class="border-l-3 border-border-brand pl-4">
        <p class="type-h3 text-text-heading">{hero.mission.quote}</p>
      </blockquote>
      {hero.mission.notes.map((note) => <p class="type-body max-w-[720px] text-text-body">{note}</p>)}
    </div>
  </Section>

  {/* 5-4 運営方針（2 列 ×2 段。Mobile 1 列） */}
  <Section labelledby="about-values" class="phrase">
    <SectionHeading id="about-values" title={values.heading} />
    <div class="mt-8 grid gap-4 md:grid-cols-2 md:gap-8">
      {values.cards.map((card) => <IconCard icon={iconOf(card.icon)} title={card.title} body={card.body} />)}
    </div>
  </Section>

  {/* 5-5a これまでにやってきたこと（面は白＋枠） */}
  <Section labelledby="about-career" class="phrase">
    <article class="flex flex-col gap-4 rounded-md border border-border bg-surface p-6 md:p-8">
      <h2 id="about-career" class="type-h3 text-text-heading">{career.heading}</h2>
      <p class="type-body max-w-[720px] text-text-body">{career.body.join('')}</p>
      <p class="type-small max-w-[720px] text-text-muted">{career.note}</p>
    </article>
  </Section>

  {/* 5-5b 自社での運用（「準備中」の Badge） */}
  <Section labelledby="about-self" class="phrase">
    <article class="flex flex-col items-start gap-6 rounded-md border border-border bg-surface p-6 md:p-8">
      <h2 id="about-self" class="type-h3 text-text-heading">{selfOperation.heading}</h2>
      <p class="type-body max-w-[720px] text-text-body">{selfOperation.body.join('')}</p>
      <Badge variant="secondary" className="h-6 py-1">{selfOperation.badge}</Badge>
    </article>
  </Section>

  {/* 5-6 会社情報（2 列の表。項目列 Desktop 240px・Mobile 96px）。
      リンクのあるセルだけ地を白にする（role/text-link は role/surface-subtle の上で 4.22:1 になり AA に届かないため。text-link の色は変えない。H-15） */}
  <Section labelledby="about-company">
    <SectionHeading id="about-company" title={company.heading} />
    <table class="mt-8 w-full table-fixed border-collapse">
      <caption class="sr-only">{company.heading}</caption>
      <colgroup>
        <col class="w-24 md:w-60" />
        <col />
      </colgroup>
      <tbody>
        {
          company.rows.map((row) => (
            <tr class="border-b border-border">
              <th scope="row" class="type-label p-2 text-left align-middle text-text-body">
                <KeepTogether text={row.label} words={LABEL_KEEP_TOGETHER} />
              </th>
              <td
                class:list={[
                  'type-body p-2 align-middle text-text-body [overflow-wrap:anywhere]',
                  hasLink(row.value) ? 'bg-surface' : 'bg-surface-subtle',
                ]}
              >
                <RichTextView text={row.value} />
              </td>
            </tr>
          ))
        }
      </tbody>
    </table>
  </Section>

  {/* 5-7 メンバー（ダミー。人名・肩書きを入れない） */}
  <Section labelledby="about-members" class="phrase">
    <SectionHeading id="about-members" title={members.heading} lead={members.body} />
    <div class="mt-8 grid gap-4 md:grid-cols-2 md:gap-8">
      {members.cards.map((card) => <IconCard image title={card.body} />)}
    </div>
  </Section>

  {/* 5-8 CTA バナー（主 CTA） */}
  <Section>
    <CTABanner title={ctaBanner.heading} body={ctaBanner.body}>
      <CTAButton
        slot="cta"
        ctaId="consult_about_banner"
        href={contactHref({ cta: 'consult_about_banner', from })}
        size="lg"
        fullWidth="mobile"
      >
        {ctaBanner.button}
      </CTAButton>
    </CTABanner>
  </Section>
</BaseLayout>
