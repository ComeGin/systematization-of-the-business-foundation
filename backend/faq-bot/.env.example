# --- 待ち受け（開発の入口だけ。本番の Lambda は使わない）---
# 3107 は faq-bot 用（.claude/CLAUDE.md のポート表）。開発の Chatwoot（Docker）からは host-relay 経由で届く
HOST=127.0.0.1
PORT=3107

# --- Chatwoot（I-32）---
# 開発は http://127.0.0.1:3100、本番は https://chat.comegin.com
CHATWOOT_BASE_URL=http://127.0.0.1:3100
# アカウントの ID（setup が入れる）
CHATWOOT_ACCOUNT_ID=
# エージェントボット「FAQ ボット」のトークン（api_access_token）。setup が入れる。本番は Secrets Manager
CHATWOOT_BOT_TOKEN=
# エージェントボットの secret（Webhook の署名の鍵）。setup が入れる。本番は Secrets Manager
CHATWOOT_BOT_SECRET=

# --- FAQ（I-33）---
# 開発は Astro の dev（http://localhost:4321/faq.json）、本番は https://comegin.com/faq.json
FAQ_URL=http://localhost:4321/faq.json
# 索引の更新間隔（秒）
FAQ_REFRESH_SECONDS=600

# --- 照合のしきい値（仕様 7.2）---
FAQ_MATCH_HIGH=0.5
FAQ_MATCH_LOW=0.25
FAQ_MATCH_MARGIN=0.1
