      "name": "OpenSEO の health を取る",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        0
      ],
      "notes": "開発環境の OpenSEO（127.0.0.1:3001）。コンテナからは middleware/host-relay の nginx 経由で、GET /api/health だけが通る。応答は status（ok か issues）と checks（dataforseo・gsc・database。error か ok）。つながらない・HTTP エラーは error として次に渡る。",
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "state",
              "name": "state",
              "type": "string",
              "value": "={{ !$json.error && $json.status === 'ok' ? 'ok' : 'ng' }}"
            },
            {
              "id": "detail",
              "name": "detail",
              "type": "string",
              "value": "={{ $json.error ? '応答なし（OpenSEO が起動しているか、host-relay が動いているかを確認する）' : ($json.status === 'ok' ? '' : 'error の項目: ' + (Object.entries($json.checks ?? {}).filter(([k, v]) => v?.status === 'error').map(([k]) => k).join(', ') || '不明')) }}"
            }
          ]
        },
        "options": {}
      },
      "id": "a2f475c7-dbff-5001-aec2-2da05e239dd6",
      "name": "OpenSEO の状態を決める",
