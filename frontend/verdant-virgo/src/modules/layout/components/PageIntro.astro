---
/**
 * 下層ページの導入ヒーロー（h1。Figma の PageIntro）。地は role/surface-subtle。
 * パンくずは BaseLayout の breadcrumb が直上に同じ地で出すので、ここには持たない（上の余白はパンくずとの間隔）。
 * Desktop: テキスト左・画像枠右（slot="media"。480×360 の ImagePlaceholder など）。Mobile: 縦積み。
 * 主 CTA があれば slot="actions" に CTAButton（Mobile は fullWidth="mobile"）。
 * h1 に改行位置の指定があるときは title に BreakableHeading を渡す（計画書 P-3）。文言の既定値は持たない（H-16）。
 */
import type { LucideIcon } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { HeadingLines, type BreakableHeading } from '@/modules/marketing-ui';

interface Props {
  /** h1。改行位置の指定がある見出しは BreakableHeading で渡す。slot="title" を使うときは省く */
  title?: string | BreakableHeading;
  /** リード文（Body L・role/text-muted） */
  body?: string;
  badge?: string;
  /** バッジの文字の前のアイコン（lucide-react の部品。完了画面の「受付完了」の circle-check など） */
  badgeIcon?: LucideIcon;
  /** h1 の id（フォームなどの aria-labelledby の先にするとき。/contact） */
  titleId?: string;
}

const { title, body, badge, badgeIcon: BadgeIcon, titleId } = Astro.props;
const hasTitleSlot = Astro.slots.has('title');
if (!title && !hasTitleSlot) {
  throw new Error('PageIntro: title か slot="title" のどちらかを渡してください。');
}
const hasMedia = Astro.slots.has('media');
---

<section class="bg-surface-subtle pt-6 pb-12 md:pt-8 md:pb-16">
  <div class="site-container flex flex-col items-start gap-6 md:flex-row md:items-center md:gap-12">
    <div class="flex w-full min-w-0 flex-col items-start gap-3 md:flex-1 md:gap-4">
      {
        badge && (
          <Badge variant="secondary">
            {BadgeIcon && <BadgeIcon aria-hidden="true" data-icon="inline-start" />}
            {badge}
          </Badge>
        )
      }
      <h1 id={titleId} class="type-h1 text-text-heading">
        {hasTitleSlot ? <slot name="title" /> : typeof title === 'string' ? title : title && <HeadingLines heading={title} />}
      </h1>
      {body && <p class="type-body-lg phrase max-w-[720px] text-text-muted">{body}</p>}
      <slot name="body" />
      <slot name="actions" />
    </div>
    {
      hasMedia && (
        <div class="w-full md:w-[480px] md:shrink-0">
          <slot name="media" />
        </div>
      )
    }
  </div>
</section>
