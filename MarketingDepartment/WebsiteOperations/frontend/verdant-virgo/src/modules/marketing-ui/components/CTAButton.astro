---
/**
 * CTA のリンク（01-content-spec.md §6.3 の 1 行 ＝ 1 つ）。<a> を出す。
 * data-cta-id・data-cta-type・data-cta-role（と data-cta-service・data-cta-view）を付け、analytics の CtaTracking が拾う。
 * cta_type・既定の cta_role・cta_viewed を送るかは site-content/cta.ts の一覧から引く（cta_id を渡すだけでよい）。
 *
 * - 主 CTA は variant="primary"（1 画面 1 種類。§6.3 の注）。副 CTA は secondary / ghost / link / outline
 * - Mobile の主 CTA は実効 44px にする（03-handoff.md H-13。Figma の Large 40px に縦の余白を足す）
 * - ラベルは既定のスロットで渡す（既定値を持たない。H-16）
 * - フォームの送信ボタンはこの部品ではない（forms モジュールが <button> で作る）
 */
import { ArrowRight, Download, ExternalLink } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { ctaDataAttributes, type CtaId, type CtaRole, type ServiceInterest } from '@/modules/site-content/cta';
import type { CTAButtonIcon, CTAButtonSize, CTAButtonVariant } from '../lib/types';

export interface Props {
  ctaId: CtaId;
  href: string;
  variant?: CTAButtonVariant;
  size?: CTAButtonSize;
  /** true は常に全幅、'mobile' は md 未満だけ全幅 */
  fullWidth?: boolean | 'mobile';
  icon?: CTAButtonIcon;
  iconPosition?: 'start' | 'end';
  /** 一覧の既定の cta_role を画面で変えるとき（dl_article_end など） */
  ctaRole?: CtaRole;
  /** プランごとの内訳（§6.3 の consult_development_card・consult_pricing_card） */
  service?: ServiceInterest;
  /** 一覧の既定（cta_viewed を送るか）を変えるとき */
  trackView?: boolean;
  /** 外部のサイトへ新しいタブで開く */
  external?: boolean;
  class?: string;
  /** 親の名前付きスロットに置くときの slot 名（<a> には出さない） */
  slot?: string;
  /** そのほかの data 属性（data-chat-open など、ほかのモジュールが拾う印） */
  [key: `data-${string}`]: string | boolean | undefined;
}

const {
  ctaId,
  href,
  variant = 'primary',
  size = 'default',
  fullWidth = false,
  icon,
  iconPosition = 'start',
  ctaRole,
  service,
  trackView,
  external = false,
  class: className,
  slot: _slot,
  ...rest
} = Astro.props;

const Icon = icon === 'download' ? Download : icon === 'arrow-right' ? ArrowRight : icon === 'external-link' ? ExternalLink : null;
const attrs = ctaDataAttributes(ctaId, { ctaRole, service, trackView });
---

<a
  href={href}
  {...rest}
  {...attrs}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener noreferrer' : undefined}
  class={cn(
    buttonVariants({ variant: variant === 'primary' ? 'default' : variant, size }),
    // 記事本文（.typeset）の中に置いても、本文のリンクの見た目（下線など）を受けない
    'not-typeset',
    variant === 'primary' && 'max-md:min-h-11',
    fullWidth === true && 'w-full',
    fullWidth === 'mobile' && 'max-md:w-full',
    className,
  )}
>
  {Icon && iconPosition === 'start' && <Icon aria-hidden="true" data-icon="inline-start" />}
  <slot />
  {Icon && iconPosition === 'end' && <Icon aria-hidden="true" data-icon="inline-end" />}
</a>
