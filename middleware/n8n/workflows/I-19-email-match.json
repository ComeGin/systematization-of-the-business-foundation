  "active": false,
  "settings": {
    "executionOrder": "v1",
    "timezone": "Asia/Tokyo",
    "saveDataSuccessExecution": "none"
  },
  "pinData": {},
  "meta": {
    "description": "Chatwoot のコンタクトの email（lower）を Mautic で検索し、完全一致の件数に応じて記録するサブワークフロー。統合はしない。"
  }
