# control-plane の環境変数（正本）。実体は監視アプリ（frontend/next-js）の環境変数ファイルに書く。
# 秘密値は空欄のままコミットする。値を設定するのは人間だけ。

# ---- 中核（必須） ----
# E-15 の SQLite・Better Auth の SQLite・ローカルの状態を置く場所。作業ツリーの外にすること
# （エージェントのファイル操作が届かない場所。未設定なら ~/.local/share/comegin-control）
CONTROL_DATA_DIR=
# 承認済み main の別チェックアウト（絶対パス）。エージェント定義・ops/ をここから読む
CONTROL_MAIN_CHECKOUT=
# 作業ツリー（絶対パス）。エージェントの cwd。docs/audits・docs/proposals を書く場所
CONTROL_WORKTREE=
# 定期実行を動かすか（true / false）。既定 false。dev で誤って定期実行しないため
CONTROL_SCHEDULER_ENABLED=false
# SDK の子プロセスに HOME として渡すディレクトリ。分けると ~/.aws・~/.config/comegin・ユーザーの ~/.claude が
# 子プロセスから見えなくなる。空なら実ホームを渡し、拒否フックだけで守る（README の「HOME の分離」）
CONTROL_AGENT_HOME=

# 改善ループの周（14 日）の起点。JST の月曜の日付（YYYY-MM-DD。例 2026-11-16）。空なら cycle_days のジョブと cycle-open・cycle-collect・cycle-close は skipped
CONTROL_CYCLE_ANCHOR=
# cycle-open が周の始まりに作業場（CONTROL_WORKTREE）を origin/main に合わせるか（true / false）。既定 true。
# 変更が docs/audits・docs/proposals・docs/cycles の未追跡のファイルだけなら合わせる（main と同じ中身のものは消す）。ほかの変更があるとき・作業場が名前のあるブランチにいるときは合わせない。開発では false（開発の設定スクリプトが書く）
CONTROL_WORKTREE_SYNC=

# ---- エージェントに渡す唯一の秘密値 ----
ANTHROPIC_API_KEY=

# ---- Lighthouse CI（builtin lighthouse） ----
# 公開サイトの URL（本番は https://comegin.com）。次の 3 つに使う（campaign-planner と published-article-check では必須）:
#   1. 計測対象の URL。astro build が必須とする SITE_URL を、main のチェックアウトで動かす子プロセス（lighthouse・a11y・配信用のビルド）に渡す
#   2. エージェントのプロンプトの末尾に `SITE_URL: <URL>` の行を足す。campaign-planner はこの行が無いと何も作らずに止まる（メールのリンクと plugin.json の homepage に使うため。URL を推測しない）
#   3. published-article-check は無ければ skipped。cycle-collect は、メールのリンク先の組み立てと配信後の確認に使う（無ければその項目だけを理由つきで飛ばす）
SITE_URL=

# ---- I-13 の起票（グループ。1 つでも設定したら 4 つとも必須。全部空なら I-13 は見送り） ----
# fine-grained PAT（対象リポジトリ 1 つ。Contents と Pull requests の読み書きだけ。Administration と Actions は無し）
GITHUB_TOKEN=
# owner/repo
GITHUB_REPOSITORY=
# PR の base（既定 main）
GITHUB_BASE_BRANCH=main
# ブランチ名 <I13_ISSUE_NUMBER>-feature-proposal-<proposal_id> の Issue 番号
I13_ISSUE_NUMBER=
# PR の Reviewer（R2 の GitHub ユーザー名。起票用アカウントとは別にすること）
I13_REVIEWER=

# ---- S3 への写しとハートビート（グループ。AWS_REGION と RUNLOG_BUCKET は両方必須。全部空なら無効） ----
AWS_REGION=
# 監視アプリ用の IAM のプロファイル（空ならデフォルトの資格情報の解決順）
AWS_PROFILE=
# 親スタックの Outputs の RunLogBucketName
RUNLOG_BUCKET=
# 親スタックの Outputs の HeartbeatNamespace（既定 ComeGin/Onprem）
HEARTBEAT_NAMESPACE=ComeGin/Onprem

# ---- n8n のワークフローの書き出し（builtin n8n-export。2 つ揃ったときだけ有効。片方だけなら skipped） ----
# 本番の n8n の Public API の URL（オンプレの本番は http://127.0.0.1:5679。ADR-21）
CONTROL_N8N_EXPORT_URL=
# 本番の n8n の API キー。読み取りだけに使う（必要なスコープは workflow:list と workflow:read）。
# **スコープを付けられるのは n8n の Enterprise だけ。コミュニティ版のキーはアカウントの全権限（ワークフロー・資格情報・実行の作成・更新・削除）を持つ**
# ので、この監視アプリの env にだけ置く。エージェントには渡らない。有効化の前に、本番の n8n の版を確かめて人が判断する
# （代案の CLI〈docker exec〉は監視アプリに docker の権限が要るので採らない）。書き出しには GITHUB_* の 4 変数（I-13 と同じ）も要る
CONTROL_N8N_EXPORT_API_KEY=

# ---- 本番の Strapi（builtin published-article-check の読み取りと、article-cover・campaign-asset-upload の書き込み。URL と読み取りトークンはグループ。両方空なら published-article-check は skipped） ----
# 本番の Strapi の URL（オンプレの本番は http://127.0.0.1:1338。ADR-21。開発の Strapi を指すと配信用のビルドが止まる）
CONTROL_STRAPI_URL=
# 読み取り専用の API トークン（権限は article の find / findOne。下書きを読むため、記事の下書きも読める権限にする）。配信用のビルドの STRAPI_API_TOKEN にもなる
CONTROL_STRAPI_READ_TOKEN=
# 書き込み用の API トークン（任意。アイキャッチの設定・配布ファイルのアップロードだけに使う。無ければ書き込みの builtin は skipped）。記事の公開の権限は付けない
CONTROL_STRAPI_WRITE_TOKEN=

# ---- アイキャッチ画像の生成（builtin article-cover。OpenAI の Images API。キーが空なら article-cover は skipped。書き込み用の Strapi トークンも要る。エージェントには渡さない） ----
OPENAI_API_KEY=
# 画像のモデル（任意。既定 gpt-image-2.5-sunburst。2026-11-09 に OpenAI の公式ドキュメントで確認。速度重視なら gpt-image-2.5-flare）
CONTROL_OPENAI_IMAGE_MODEL=
# 画像のサイズ（任意。既定 1536x1024 の横長。幅x高さ）
CONTROL_OPENAI_IMAGE_SIZE=
# 1 回の実行で作る枚数の上限（任意。既定 3。1〜10。費用の上限）
CONTROL_COVER_MAX_PER_RUN=

# ---- 配信（deploy の項目に出す aws のコマンドへ埋める値。3 つともグループ。control-plane は配信を実行しない。cloud/README.md の 4.14） ----
# 親スタックの Outputs の AstroBucketName
CONTROL_DEPLOY_BUCKET=
# 親スタックの Outputs の DistributionId
CONTROL_DEPLOY_DISTRIBUTION_ID=
# 配信用の aws のプロファイル（comegin-prod-deploy。許可セット ComeginProdDeploy）
CONTROL_DEPLOY_AWS_PROFILE=

# ---- 本番の Mautic の読み取り（cycle-collect が campaign の項目の中身と、公開＝送信の開始の確認に使う。3 つともグループ） ----
# 参照専用ロール（mautic-prod-ro と同じ権限）の API 認証情報（OAuth2 client_credentials）を、control-plane 用に別に発行する。エージェントには渡さない。
# 全部空なら campaign の項目は中身を埋めず・確かめず、理由を出す（他の項目は動く）。一部だけなら起動時に例外
# 本番の Mautic の URL（末尾の / なし）
CONTROL_MAUTIC_URL=
CONTROL_MAUTIC_CLIENT_ID=
CONTROL_MAUTIC_CLIENT_SECRET=

# ---- 誤った書き込みの突き合わせ（グループ。4 つとも必須。全部空なら見送り） ----
# 参照専用トークンを使うこと
MISWRITE_CHATWOOT_BASE_URL=
MISWRITE_CHATWOOT_ACCOUNT_ID=
MISWRITE_CHATWOOT_API_TOKEN=
# エージェント専用ユーザーの Chatwoot のユーザー ID
MISWRITE_AGENT_USER_ID=
