# 音声 SEO BI エージェント（backend/livekit-agent）の環境変数の雛形。
# 開発ではこれを .env.local に写して値を入れる（.env.local は追跡しない）。オンプレの常駐では systemd の EnvironmentFile で渡す。
# 検証は src/comegin_voice/config/settings.py。誤りがあれば「変数名と理由だけ」を出して起動を止める（値は出さない）。

# --- LiveKit（SFU）。必須 ---
# 開発: backend/livekit-system の livekit-server --dev（キーは公開の固定値 devkey / secret。開発専用）
# 本番: AWS の EC2 の SFU（wss://rtc.comegin.com）。キーとシークレットは SSM の SecureString と同じ値
LIVEKIT_URL=ws://127.0.0.1:7880
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=
# dispatch の名前。監視アプリ（frontend/next-js）の LIVEKIT_AGENT_NAME と同じ値にする
LIVEKIT_AGENT_NAME=comegin-seo-bi

# --- OpenAI。必須 ---
# GPT-Live（声）・裏の Responses のモデル・ビジョン（画面共有の読み取り）。GPT-Live は有料の利用枠が要る
OPENAI_API_KEY=
GPT_LIVE_VOICE=marin
BACKEND_MODEL=gpt-5.6-luna
VISION_MODEL=gpt-5.6-luna

# --- OpenSEO（GSC・GA4 の中継）---
# 無認証（local_noauth）なので、ループバックだけを指定できる。パスは /mcp
OPENSEO_MCP_URL=http://127.0.0.1:3001/mcp
OPENSEO_PROJECT_DOMAIN=comegin.com

# --- 上限 ---
# 1 セッションの長さ（分。1〜120）、OpenSEO を呼ぶ回数（1 セッション。1〜200）、画面を読む回数（1 セッション。1〜100）
SESSION_MAX_MINUTES=30
MAX_TOOL_CALLS=40
MAX_VISION_CALLS=10

# --- 改善ループへの記録（E-12。source: voice）---
# 監視アプリの作業ツリーの docs/audits/voice の絶対パス。空なら書かない（起動時に警告を 1 回出す）
VOICE_AUDIT_DIR=

# --- 音声強化 ---
# apm（既定。WebRTC の APM の雑音抑制と低い音のカット。無料）| off（何もしない。聞き比べ用）
# | ai_coustics | krisp（有償の話者分離。プラグインとライセンスが要る）
AUDIO_ENHANCEMENT=apm
# AUDIO_ENHANCEMENT=ai_coustics のときだけ（uv sync --extra ai-coustics）
# AI_COUSTICS_API_KEY=
# AUDIO_ENHANCEMENT=krisp のときだけ（uv sync --extra krisp）。モデルは .kef のファイル
# KRISP_VIVA_SDK_LICENSE_KEY=
# KRISP_VIVA_FILTER_MODEL_PATH=
