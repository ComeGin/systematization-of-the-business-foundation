---
/**
 * BreakableHeading の中身（文字と端末別の <br>）だけを出す。見出しの要素は呼び出す側が持つ
 * （BrokenHeading・SectionHeading・PageIntro が使う）。<br> は文字を持たないので、読まれる文字は text と同じ。
 */
import { assertBreakableHeading, type BreakableHeading } from '../lib/heading';

interface Props {
  heading: BreakableHeading;
}

const { heading } = Astro.props;
assertBreakableHeading(heading);
---

{
  heading.segments.map((segment) => (
    <>
      {segment.text}
      {segment.breakAfter === 'both' && <br />}
      {segment.breakAfter === 'desktop' && <br class="hidden md:inline" />}
      {segment.breakAfter === 'mobile' && <br class="md:hidden" />}
    </>
  ))
}
