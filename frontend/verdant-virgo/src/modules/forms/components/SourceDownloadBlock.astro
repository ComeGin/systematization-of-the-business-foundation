---
// 無料 DL ブロック（01-content-spec.md §4.1 の 1-9・§4.7 の 7-5 ほか、§5.2）。id="source-dl"。
// 見出し・本文はページごとに違う（02-component-map.md §7.6）ので props で受け取る（既定値を持たない。H-16）。
// 控えめ版（subtle）＝見出しの文字は H3 の大きさ・影なし・ボタン Outline、強調版（strong）＝H2 の大きさ・shadow-md・ボタン Primary（03-handoff.md §8 の 6）。
// 見出しの要素は既定で h2（§7）。
// Desktop は左に見出し・本文・GitHub のリンク（残りの幅）、右にフォーム（440px 固定）。余白と列の間は 48px（Figma 42:3791）。Mobile は縦積み。
// フォームは client:visible（画面に入ってから JS を読む。最初の描画の前に JS を始めない〈Q3〉）。
// 水和の前に送信ボタンを押されるとブラウザが素のフォームとして送るが、method="post" なのでメールアドレスは URL に載らない。
// ブロックの根に cta_id の data 属性を付けて cta_viewed を送る（§6.3 の 9 行目。クリックは form_* で数えるので送らない）。
import { ExternalLink } from 'lucide-react';
import SourceDownloadForm from './SourceDownloadForm';
import { readFormId, readPolicyVersion } from '../lib/build-config';
import { SOURCE_DL_TEXT } from '../lib/messages';
import { ctaDataAttributes, type CtaId, type CtaRole } from '@/modules/site-content/cta';
import { SOURCE_REPO_URL } from '@/modules/site-content/nav';
import { KeepTogether } from '@/modules/marketing-ui';
import { NewTabNotice } from '@/modules/a11y';
import { NEW_TAB_NOTICE } from '@/modules/site-content/a11y';

interface Props {
  ctaId: CtaId;
  emphasis: 'subtle' | 'strong';
  title: string;
  /** 本文。配列なら要素ごとに行を分ける（トップ 1-9 は 1 文ずつ、2-7・4-7 は 1 要素）。Body 16px・role/text-muted */
  body: string | readonly string[];
  /** 文節の折り返し（phrase）でも切れてしまう語。見出しと本文の中のこの語を whitespace-nowrap で包む（H-18。例 ['方へ。']） */
  keepTogether?: readonly string[];
  /** 記事末のブロックのように、画面で role が変わるときだけ指定する */
  ctaRole?: CtaRole;
  /** 見出しの段（既定は h2。セクション見出しは h2〈§7〉。3 は明示したときだけ。見た目の大きさは emphasis で決まる） */
  headingLevel?: 2 | 3;
  class?: string;
}

const { ctaId, emphasis, title, body, keepTogether, ctaRole, headingLevel, class: className } = Astro.props;
// 公開リポジトリの URL は nav.ts の 1 か所だけ（【要記入】の間は null で、リンクを出さない。§6.3.1）
const repositoryUrl = SOURCE_REPO_URL;
const Heading = `h${headingLevel ?? 2}` as 'h2' | 'h3';
const formId = readFormId('MAUTIC_FORM_ID_SOURCE_DL');
const policyVersion = readPolicyVersion();
const lines = typeof body === 'string' ? [body] : body;
// 見出しの id。フォームの名前にする（aria-labelledby。新しい文言を足さない）。cta_id は 1 ページに 1 つなので重ならない
const headingId = `${ctaId}-heading`;
const attrs = { ...ctaDataAttributes(ctaId, { ctaRole }), 'data-cta-click': 'false' };
---

<section
  id="source-dl"
  class:list={[
    'scroll-mt-20 rounded-xl border border-border bg-card p-6 md:grid md:grid-cols-[minmax(0,1fr)_440px] md:gap-12 md:p-12',
    emphasis === 'strong' && 'shadow-md',
    className,
  ]}
  {...attrs}
>
  <div class="grid content-start gap-3">
    <Heading id={headingId} class:list={['phrase font-bold text-text-heading', emphasis === 'strong' ? 'text-2xl leading-[1.3] md:text-3xl' : 'text-xl leading-normal md:text-2xl']}>
      <KeepTogether text={title} words={keepTogether} />
    </Heading>
    <p class="phrase text-base leading-[1.75] text-muted-foreground">{lines.map((line) => <span class="block"><KeepTogether text={line} words={keepTogether} /></span>)}</p>
    {
      repositoryUrl && (
        <a
          href={repositoryUrl}
          target="_blank"
          rel="noopener"
          class="inline-flex w-fit items-center gap-1.5 py-1.5 text-sm leading-5 font-medium text-text-link underline hover:text-text-link-hover"
        >
          {SOURCE_DL_TEXT.repositoryLink}
          <NewTabNotice text={NEW_TAB_NOTICE} />
          <ExternalLink aria-hidden="true" className="size-4" />
        </a>
      )
    }
  </div>
  <div class="mt-6 md:mt-0">
    <SourceDownloadForm client:visible formId={formId} policyVersion={policyVersion} ctaId={ctaId} emphasis={emphasis} labelledBy={headingId} />
  </div>
</section>
