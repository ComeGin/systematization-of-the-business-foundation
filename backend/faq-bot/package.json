{
  "name": "faq-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Chatwoot agent bot that answers website FAQs by string similarity (AWS Lambda in production)",
  "type": "module",
  "main": "dist/index.js",
  "packageManager": "pnpm@11.17.0",
  "scripts": {
    "build": "tsc",
    "bundle": "esbuild src/lambda.ts --bundle --platform=node --target=node22 --format=esm --sourcemap --outfile=dist-lambda/index.mjs --external:@aws-sdk/*",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "clean": "rm -rf dist dist-lambda"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "zod": "^4.2.0"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.1146.0",
    "@types/node": "^24.0.0",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.13",
    "typescript": "^7.0.2",
    "vitest": "5.0.1"
  }
}
