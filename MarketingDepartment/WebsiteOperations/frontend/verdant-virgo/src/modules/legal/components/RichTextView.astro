---
// 太字・リンク・等幅を含む 1 文を描く。外部リンクは新しいタブ（03-handoff §0.3）。
// リンクは role/text-link ＋ 下線、ホバーは role/text-link-hover（H-15・§3.1）。強調は太字だけ（§0.2）
// keepTogether の語は whitespace-nowrap で包み、途中で折り返さない（H-18。地の文と太字の中だけ）
import { splitKeepTogether } from '@/modules/marketing-ui';
import { isCode, isLink, isStrong, opensInNewTab, toInlines, type RichText } from '../rich-text';

interface Props {
  text: RichText;
  /** 途中で折り返さない語 */
  keepTogether?: readonly string[];
}

const { text, keepTogether } = Astro.props;
const nodes = toInlines(text).map((node) =>
  typeof node === 'string' ? { kind: 'text' as const, pieces: splitKeepTogether(node, keepTogether) } : isStrong(node) ? { kind: 'strong' as const, pieces: splitKeepTogether(node.strong, keepTogether) } : { kind: 'other' as const, node },
);
const linkClass = 'text-text-link underline underline-offset-4 hover:text-text-link-hover';
---

{
  nodes.map((item) => {
    if (item.kind === 'text') return item.pieces.map((piece) => (piece.keep ? <span class="whitespace-nowrap">{piece.text}</span> : piece.text));
    if (item.kind === 'strong')
      return (
        <strong class="font-bold">
          {item.pieces.map((piece) => (piece.keep ? <span class="whitespace-nowrap">{piece.text}</span> : piece.text))}
        </strong>
      );
    const { node } = item;
    if (isCode(node)) return <code class="font-mono">{node.code}</code>;
    if (isLink(node)) {
      return opensInNewTab(node) ? (
        <a href={node.href} target="_blank" rel="noopener noreferrer" class={linkClass}>
          {node.text}
        </a>
      ) : (
        <a href={node.href} class={linkClass}>
          {node.text}
        </a>
      );
    }
    return null;
  })
}
