---
/**
 * 番号付きの手順（Figma の Steps）。<ol> で出す（番号は並び順から振る）。
 * direction=horizontal: Desktop は columns 列の格子で、同じ行の段のあいだに右向きの矢印。Mobile は縦並びになる。
 * direction=vertical: 番号の右に本文を置き、段のあいだに下向きの矢印（無料相談 6-5 のカードなど）。
 * columns の既定は段数 4 なら 2、それ以外は 3（01-content-spec.md §0.3。4 列以上は本文を載せない）。
 * 段の文言はすべて items で渡す（既定値を持たない。02-component-map.md §7.2 の事故を繰り返さない）。
 */
import { ArrowDown, ArrowRight } from 'lucide-react';
import { cn } from '@/lib/utils';
import type { HeadingLevel, StepContent } from '../lib/types';
import StepItem from './StepItem.astro';

interface Props {
  items: StepContent[];
  direction?: 'horizontal' | 'vertical';
  columns?: 2 | 3;
  level?: HeadingLevel;
  /** 手順の一覧の読み上げ名（見出しが無い場所に置くとき） */
  label?: string;
  class?: string;
}

const { items, direction = 'horizontal', columns, level = 'h3', label, class: className } = Astro.props;
const cols = columns ?? (items.length === 4 ? 2 : 3);
const horizontal = direction === 'horizontal';
---

<ol
  aria-label={label}
  data-steps={horizontal ? 'horizontal' : 'vertical'}
  data-columns={cols}
  class={cn(
    'flex flex-col gap-2',
    // Figma: 段と段のあいだ 56px（16 ＋ 矢印 24 ＋ 16）、行のあいだ 32px
    horizontal && 'md:grid md:gap-x-14 md:gap-y-8',
    horizontal && (cols === 2 ? 'md:grid-cols-2' : 'md:grid-cols-3'),
    className,
  )}
>
  {
    items.map((item, i) => (
      <li class="relative flex flex-col gap-2">
        {i > 0 && (
          <span aria-hidden="true" class={cn('flex pl-2 text-text-muted', horizontal && 'md:hidden')}>
            <ArrowDown className="size-6" />
          </span>
        )}
        {horizontal && i % cols !== 0 && (
          <span aria-hidden="true" class="absolute top-2 -left-10 hidden text-text-muted md:block">
            <ArrowRight className="size-6" />
          </span>
        )}
        <StepItem
          number={i + 1}
          title={item.title}
          body={item.body}
          period={item.period}
          keepTogether={item.keepTogether}
          level={level}
          layout={horizontal ? 'stacked' : 'inline'}
          class={horizontal ? 'max-md:flex-row max-md:gap-4' : undefined}
        />
      </li>
    ))
  }
</ol>
