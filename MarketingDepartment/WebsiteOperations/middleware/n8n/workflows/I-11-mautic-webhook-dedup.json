    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "{\"error\":\"unauthorized\"}",
        "options": {
          "responseCode": 401
        }
      },
      "id": "1ddeea5f-eaa4-56f4-a1ad-06d31512726d",
      "name": "401 を返す（署名が不正）",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        1120,
        192
      ],
      "notes": "ここで止まる（以降の処理には進まない）。"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// 署名を検証した Webhook の本文を、Webhook ノードから直接読む\nconst body = $('Mautic からの Webhook').first().json.body ?? {};\nconst seen = new Set();\nconst out = [];\n\nfor (const [eventType, events] of Object.entries(body)) {\n  // トップレベルの timestamp などの配列でない値は読み飛ばす\n  if (!Array.isArray(events)) continue;\n\n  for (const ev of events) {\n    const contactId = ev?.contact?.id ?? ev?.submission?.lead?.id ?? null;\n    // 取り扱うのはコンタクトに紐づくイベントだけ（会社のイベントなどは対象外）\n    if (contactId === null) continue;\n\n    const parsed = Date.parse(ev?.timestamp ?? body.timestamp ?? '');\n    // timestamp が読めないときは受信時刻で代用する（その場合は重複排除が効かない）\n    const timestampSec = Math.floor((Number.isNaN(parsed) ? Date.now() : parsed) / 1000);\n\n    const dedupKey = contactId + '|' + eventType + '|' + timestampSec;\n    if (seen.has(dedupKey)) continue;\n    seen.add(dedupKey);\n\n    // BA-04: 通知するのは「無料相談フォームの送信」と「MQL への到達」だけ。無料 DL は通知しない\n    let kind = '';\n    if (eventType === 'mautic.form_on_submit' && ev?.submission?.form?.alias === 'consult') {\n      kind = 'demo-requested';\n    } else if (eventType === 'mautic.lead_list_change' && ev?.action === 'added' && (ev?.segment?.alias ?? ev?.segment?.name) === 'mql') {\n      kind = 'mql';\n    }\n\n    out.push({\n      json: {\n        dedupKey,\n        contactId,\n        eventType,\n        timestampSec,\n        kind,\n        topic: kind ? 'comegin-lead-alert' : '',\n        company: ev?.submission?.lead?.fields?.core?.company?.value ?? ev?.contact?.fields?.core?.company?.value ?? '',\n        formAlias: ev?.submission?.form?.alias ?? '',\n      },\n    });\n  }\n}\n\nreturn out;"
      },
      "id": "3eba7379-2a3f-5469-924d-3a0ebf6aee7f",
      "name": "イベント分割とキー生成",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
