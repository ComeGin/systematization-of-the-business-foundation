---
/**
 * グローバルフッター（01-content-spec.md §1.4、Figma の SiteFooter）。
 * Desktop: 列 1（ロゴ横組み 160px ＋ 説明）＋ リンク 3 列、下段に罫線とコピーライト。
 * Mobile: 縦積み（Accordion にしない）。リンクは 1 行 48px。
 * 地は role/surface（白）なのでロゴはフルカラー版（GL §4.5）。リンクは role/text-link ＋ 下線。
 * 「Cookie 設定」はページ遷移しない <button data-consent-open>（consent モジュールが拾ってバナーを再表示する）。
 */
import { Logo } from '@/modules/brand';
import { contactHref, ctaDataAttributes } from '@/modules/site-content/cta';
import { copyright, footerColumns, footerDescriptionLines, type FooterItem } from '@/modules/site-content/nav';

interface Props {
  /** ページの中に無料 DL ブロック（#source-dl）があるか。無ければトップの #source-dl へ */
  sourceDlOnPage: boolean;
}

const { sourceDlOnPage } = Astro.props;
const path = Astro.url.pathname;

const linkHref = (item: Extract<FooterItem, { kind: 'link' }>): string => {
  if (item.ctaId === 'consult_global_footer') return contactHref({ cta: item.ctaId, from: path });
  if (item.ctaId === 'dl_global_footer') return sourceDlOnPage ? '#source-dl' : '/#source-dl';
  return item.href;
};

const itemClass = 'type-ui-text text-text-link underline hover:text-text-link-hover';
---

<footer class="border-t border-border bg-surface">
  <div class="site-container flex flex-col gap-8 pt-12 pb-8 md:gap-12 md:pt-16">
    <div class="flex flex-col gap-8 md:flex-row md:gap-12">
      <div class="flex flex-col gap-6 md:w-[360px] md:shrink-0">
        <a href="/" class="-m-1 self-start rounded-md p-1">
          <Logo lockup="horizontal" color="fullcolor" width={160} />
        </a>
        <p class="type-small text-text-muted">
          {footerDescriptionLines.map((line) => <span class="block">{line}</span>)}
        </p>
      </div>

      {
        footerColumns.map((column) => (
          <nav aria-label={column.heading} class="flex flex-col gap-1 md:flex-1 md:gap-3">
            <p class="type-label text-text-body">{column.heading}</p>
            <ul class="flex flex-col gap-1 md:gap-3">
              {column.items.map((item) => (
                <li class="flex min-h-12 items-center md:min-h-0">
                  {item.kind === 'consent-settings' ? (
                    <button type="button" data-consent-open class={`${itemClass} text-left`}>
                      {item.label}
                    </button>
                  ) : item.external ? (
                    <a href={linkHref(item)} target="_blank" rel="noopener noreferrer" class={itemClass}>
                      {item.label}
                      <span class="sr-only">（新しいタブで開きます）</span>
                    </a>
                  ) : (
                    <a href={linkHref(item)} class={itemClass} {...(item.ctaId ? ctaDataAttributes(item.ctaId) : {})}>
                      {item.label}
                    </a>
                  )}
                </li>
              ))}
            </ul>
          </nav>
        ))
      }
    </div>

    <hr class="border-border" />

    <p class="type-caption text-text-muted">{copyright}</p>
  </div>
</footer>
