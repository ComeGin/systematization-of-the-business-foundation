# 本番の Strapi（オンプレ。ADR-21）の設定
#
# このファイルは compose.yml と同じディレクトリに置く .env のひな形。.env は追跡しない（600）。
# 鍵類は dev/init-env.sh が生成する:
#   ./dev/init-env.sh
# 空のままにしておけば同スクリプトが値を作って書き込む（既に値がある項目は変更しない）。
# RDS のパスワード・IAM ユーザーのキー・バケット名・PostHog のトークンは人が入れる（スクリプトは作らない）。
#
# 開発環境の backend/strapi-system/.env とは別のファイル・別のインスタンス（ポートも 1337 ではなく 1338）。
# 変数名は backend/strapi-system/.env.example に合わせてある。

# ホスト側のポート（127.0.0.1 だけ。開発の Strapi は 1337）。PUBLIC_URL はこの値から組み立てる
STRAPI_PORT_HOST=1338

# ===== 鍵類（dev/init-env.sh が生成）=====
# APP_KEYS・ADMIN_JWT_SECRET・JWT_SECRET を変えると、発行済みのセッションがすべて無効になる。
# ENCRYPTION_KEY を変えると、暗号化して保存済みの値（API トークンなど）を復号できなくなる。
# 生成したら、.env とは別の場所（パスワードマネージャーなど）に控える。
APP_KEYS=
API_TOKEN_SALT=
ADMIN_JWT_SECRET=
TRANSFER_TOKEN_SALT=
JWT_SECRET=
ENCRYPTION_KEY=

# ===== RDS（PostgreSQL の strapi データベース。WireGuard 越し）=====
# DATABASE_CLIENT=postgres と DATABASE_SSL=true は compose.yml に固定してある。
# 証明書の検証は既定のまま（true）にする。DATABASE_SSL_REJECT_UNAUTHORIZED は設定しない（空にもしない。空文字は false と読まれる）。
# イメージに RDS の CA 束が入っていて（backend/strapi-system/Dockerfile の NODE_EXTRA_CA_CERTS）、検証つきでつながる。
# エンドポイント（例: comegin-prod-xxxx.xxxxxxxx.ap-northeast-1.rds.amazonaws.com）。人が入れる。
# VPC の中のアドレスに解決される。TLS の検証はこのホスト名で行うので、IP アドレスで書かない
DATABASE_HOST=
DATABASE_PORT=5432
DATABASE_NAME=strapi
DATABASE_USERNAME=strapi
# strapi ユーザーのパスワード。人が入れる（権限は strapi データベースだけに絞られている）。
# Secrets Manager の comegin/prod/strapi/DB_PASSWORD から取り出す（cloud/README.md の 4.8）
DATABASE_PASSWORD=

# ===== メディア（S3）=====
# UPLOAD_PROVIDER=aws-s3 は compose.yml に固定してある。バケットは公開しない（署名付き URL で配る）。
# 本番のメディアのバケット名（SAM の出力から写す）。人が入れる
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=ap-northeast-1
# IAM ユーザー comegin-<env>-onprem-strapi-media のアクセスキー（メディアのバケットへの Put・Get・Delete・List だけ）。
# IAM ユーザー名は親スタックの出力 OnpremStrapiMediaUserName。キーの発行は cloud/README.md の 4.5。
# キーは人が発行して、ここ（600 のファイル）にだけ置く。ほかの場所（リポジトリ・チャット）に貼らない。
# Claude Code の環境変数には引き継がない。
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=

# ===== PostHog（src/posthog.ts）=====
# イメージは NODE_ENV=production なので、本番では必須（無いと起動しない）。本番のプロジェクトのトークン（phc_ で始まる）。人が入れる
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
