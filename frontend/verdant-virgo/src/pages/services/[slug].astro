---
// 画面 3 サービス詳細（/services/<slug>）。01-content-spec.md §4.3（受託開発）・§4.3+（環境構築・コンサル・業務提携）。
// Figma は受託開発だけ（Service detail / Desktop 1440〈46:9432〉・Mobile 390〈47:8950〉）。残り 3 件は同じ型に §4.3+ の文言を入れる。
// 枠: パンくず → 導入ヒーロー（写真つき）→（業務提携だけ 写真の並び）→ プラン → こんな方に → 進め方 → よくある質問 → 関連記事 → CTA バナー。
// 短い文が並ぶセクションには phrase（文節で折り返す）を付ける（H-18。トップと同じ）。
import { Check } from 'lucide-react';
import { BLOG_CATEGORIES } from '@/modules/blog';
import { BaseLayout, PageIntro } from '@/modules/layout';
import { Photo } from '@/modules/media';
import { CtaGlow, GlowGrid, MorphGallery } from '@/modules/motion';
import { DioramaIntro } from '@/modules/diorama';
import {
  BlogCard,
  CTABanner,
  CTAButton,
  FAQItem,
  IconCard,
  PricingCard,
  Section,
  SectionHeading,
  Steps,
} from '@/modules/marketing-ui';
import { VT } from '@/modules/page-transition';
import { MOTION_PAUSE, MOTION_PAUSE_TARGETS } from '@/modules/site-content/a11y';
import { blogCardSample } from '@/modules/site-content/blog';
import { PRICING, TAX_NOTE } from '@/modules/site-content/pricing';
import { SEO } from '@/modules/site-content/seo';
import {
  ctaHref,
  SERVICE_DETAILS,
  SERVICE_ORDER,
  type ServiceDetailCopy,
  type ServiceSlug,
} from '@/modules/site-content/services';

export function getStaticPaths() {
  return SERVICE_ORDER.map((slug) => ({ params: { slug } }));
}

const SEO_BY_SLUG = {
  'environment-setup': SEO.serviceEnvironmentSetup,
  development: SEO.serviceDevelopment,
  consulting: SEO.serviceConsulting,
  partnership: SEO.servicePartnership,
} as const satisfies Record<ServiceSlug, unknown>;

const slug = Astro.params.slug as ServiceSlug;
const detail: ServiceDetailCopy = SERVICE_DETAILS[slug];
const seo = SEO_BY_SLUG[slug];
const from = Astro.url.pathname;
const { h1, breadcrumb, hero, gallery, plans, fit, steps, faq, related, banner } = detail;

const categoryLabel = (intent: (typeof related.cardIntents)[number]) => {
  const category = BLOG_CATEGORIES.find((c) => c.intent === intent);
  if (!category) throw new Error(`services/[slug]: 検索意図「${intent}」のカテゴリがありません。`);
  return category.label;
};

// 同じ cta_id を複数のカードで使う画面だけ、cta_clicked に service を付けて内訳を分ける（§6.3。consult_development_card）
const splitByService = plans.cards.length > 1;
---

<BaseLayout title={seo.title} description={seo.description} noindex={seo.noindex} breadcrumb={breadcrumb.slice(1)} breadcrumbTone="surface" motionZone="vivid">
  {/* 導入ヒーロー（Badge・h1・本文・主 CTA）。A（vivid）なので地は navy。背景は基盤の模型（DioramaIntro）。パンくずの帯は白（surface） */}
  {/* h1 は vt-service-title を静的に持つ（トップ・サービス一覧のカードの見出しから形がつながる。page-transition） */}
  <PageIntro tone="dark" title={h1} badge={hero.badge} titleViewTransitionName={VT.serviceTitle}>
    <div slot="body" class="type-body-lg phrase max-w-[720px] text-text-on-hero-muted">
      {hero.body.map((paragraph) => <p>{paragraph}</p>)}
    </div>
    <CTAButton slot="actions" ctaId={hero.cta.ctaId} href={ctaHref(hero.cta, from)} size="lg" fullWidth="mobile">
      {hero.cta.label}
    </CTAButton>
    {/* 2026-10-28: 背景はこのサービスを担う模型の部品に寄った「基盤の模型」（眺めるだけ。spec §6.7）。写真はヒーローの直下へ移した（H-12） */}
    <DioramaIntro slot="backdrop" page={`service:${slug}`} pauseLabel={MOTION_PAUSE.pause} resumeLabel={MOTION_PAUSE.resume} pauseTarget={MOTION_PAUSE_TARGETS.diorama} />
  </PageIntro>



  {/* 写真の並び（業務提携だけ）。MorphGallery が 3 分野の写真をラジオで切り替える。名前は見出しを指す（新しい文言を足さない） */}
  {
    gallery && (
      <Section labelledby="detail-gallery" class="phrase">
        <SectionHeading id="detail-gallery" title={gallery.heading} />
        <MorphGallery items={[...gallery.items]} labelledby="detail-gallery" class="mt-8 md:mt-12" />
      </Section>
    )
  }

  {/* プラン（PricingCard。カードの直下に税込の注記） */}
  <Section labelledby="detail-plans" class="phrase">
    <SectionHeading id="detail-plans" title={plans.heading} />
    {/* カードが 1 枚のページも、2 列の型の左の列に置く（Figma の 2 列のカード幅のまま） */}
    <div class="mt-8 grid gap-4 md:mt-12 md:grid-cols-2 md:gap-6">
      {
        plans.cards.map((card) => {
          const row = PRICING[card.key];
          return (
            <PricingCard
              product={row.product}
              badge={card.badge ?? undefined}
              description={card.description}
              price={row.price}
              period={row.period}
              note={row.note ?? undefined}
            >
              <CTAButton
                slot="cta"
                ctaId={card.cta.ctaId}
                href={ctaHref(card.cta, from)}
                service={splitByService && card.cta.target.type === 'contact' ? card.cta.target.service : undefined}
                fullWidth
              >
                {card.cta.label}
              </CTAButton>
              {card.sourceDlLink && (
                <CTAButton slot="sub-link" ctaId={card.sourceDlLink.ctaId} href={ctaHref(card.sourceDlLink, from)} variant="link" icon="download">
                  {card.sourceDlLink.label}
                </CTAButton>
              )}
            </PricingCard>
          );
        })
      }
    </div>
    <p class="type-small mt-8 text-text-muted md:mt-12">{TAX_NOTE}</p>
  </Section>

  {/* こんな方に向いています（見出しの右に Badge「要確認」。§0.1） */}
  <Section labelledby="detail-fit" class="phrase">
    {/* 2026-10-28: 見出しの右に、ヒーローから移した写真（4:3。H-12。置き場所はユーザーが決めた） */}
    <div class="grid gap-8 md:grid-cols-[minmax(0,1fr)_minmax(0,320px)] md:items-center md:gap-12">
      <SectionHeading id="detail-fit" title={fit.heading} badge={fit.headingBadge} badgeVariant="outline" />
      <Photo photo={hero.photo} sizes="(min-width: 768px) 320px, 100vw" class="aspect-[4/3] w-full rounded-lg" />
    </div>
    <GlowGrid class="mt-8 grid gap-4 md:mt-12 md:grid-cols-2 md:gap-6">
      {
        fit.groups.map((group) => {
          const list = (
            <ul class="type-body flex flex-col gap-3 text-text-body">
              {group.items.map((item) => (
                <li class="flex items-start gap-3">
                  <Check aria-hidden="true" strokeWidth={3} className="mt-1 size-5 shrink-0 text-text-heading" />
                  <span>{item}</span>
                </li>
              ))}
            </ul>
          );
          // 見出しのあるカード（受託開発の 2 プラン）は IconCard、見出しの無いカード（残り 3 件）は枠だけ
          return group.title ? (
            <IconCard data-glow-card title={group.title}>
              <Fragment slot="body">{list}</Fragment>
            </IconCard>
          ) : (
            <div data-glow-card class="rounded-md border border-border bg-surface p-6">{list}</div>
          );
        })
      }
    </GlowGrid>
  </Section>

  {/* 進め方（Desktop は 3 列 ＋ 2 列 または 2 列 ×2 段、Mobile 縦 1 列） */}
  <Section labelledby="detail-steps" class="phrase">
    <SectionHeading id="detail-steps" title={steps.heading} />
    <Steps items={[...steps.items]} columns={steps.desktopLayout === '2x2' ? 2 : 3} class="mt-8 md:mt-12" />
  </Section>

  {/* よくある質問（最初の 1 件だけ開く） */}
  <Section labelledby="detail-faq">
    <SectionHeading id="detail-faq" title={faq.heading} />
    <div class="mt-8 md:mt-12">
      {faq.items.map((item, i) => <FAQItem question={item.question} answer={item.answer} open={i === 0} marker={item.marker} />)}
    </div>
  </Section>

  {/* 関連記事（BlogCard ×3。ダミー。中身はブログ一覧 7-4 と同じ） */}
  <Section labelledby="detail-related" class="phrase">
    <SectionHeading id="detail-related" title={related.heading} />
    <div class="mt-8 grid gap-4 md:mt-12 md:grid-cols-3 md:gap-6">
      {
        related.cardIntents.map((intent) => (
          <BlogCard href="/blog" title={blogCardSample.title} excerpt={blogCardSample.excerpt} date={blogCardSample.date} category={categoryLabel(intent)} />
        ))
      }
    </div>
  </Section>

  {/* CTA バナー（主 CTA） */}
  <Section>
    <CTABanner id="cta-banner" title={banner.title} body={banner.body}>
      <CTAButton slot="cta" ctaId={banner.cta.ctaId} href={ctaHref(banner.cta, from)} size="lg" fullWidth="mobile">
        {banner.cta.label}
      </CTAButton>
      <CtaGlow slot="decoration" pauseLabel={MOTION_PAUSE.pause} resumeLabel={MOTION_PAUSE.resume} pauseTarget={MOTION_PAUSE_TARGETS.cta} />
    </CTABanner>
  </Section>
</BaseLayout>
