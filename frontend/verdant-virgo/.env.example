# 本番サイトの絶対 URL。sitemap.xml の各 URL と canonical の基点になる。
# 末尾スラッシュ不要。ビルド時に未設定だとエラーで停止する。
SITE_URL=https://example.com

# ビルドの種類。配信用のビルドだけ production にする（既定は development）。
# production のとき、STRAPI_URL が localhost を指していたらビルドを停止する
# （開発の Strapi の試験記事が公開されるのを防ぐ。DD-05 の 1.2）。
BUILD_TARGET=development

# ===== Strapi（ビルド時だけ読む。DD-05 の 1 節）=====
# Strapi の Content API のオリジン。開発は http://localhost:1337、配信用のビルドは https://cms.comegin.com。
# PUBLIC_ を付けない（ブラウザに渡る JS に Strapi の所在を出さない。DD-05 の 1.5.1）。
STRAPI_URL=http://localhost:1337
# 読み取り専用の API トークン（権限は article・category・author の find / findOne だけ）。
# Strapi の管理画面の Settings > API Tokens で人が発行する。本番のトークンは .env.production にだけ置く。
STRAPI_API_TOKEN=
# Strapi のメディアの S3 のバケット名とリージョン（本番だけ。開発はローカルのアップロードなので空）。
# Strapi の設定（onprem/strapi/.env.example）と同じ名前・同じ値にする。
# dist/ にこのバケットの URL が残っていたらビルドを失敗させる検査に使う（DD-05 の 1.5.4）。
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=ap-northeast-1

# ===== Google アナリティクス（GA4。DD-02 の 2 節）=====
# 本番のプロパティの測定 ID（G- で始まる。秘密値ではない）。
# 開発では設定しない（未設定ならタグを出さない。ADR-25）。
PUBLIC_GA4_MEASUREMENT_ID=

# ===== PostHog（DD-02 の 3 節）=====
# プロジェクトのトークン（phc_ で始まる。公開ページに埋め込む前提の値）。開発と本番でプロジェクトを分ける。
# 未設定なら PostHog を読み込まない。
PUBLIC_POSTHOG_PROJECT_TOKEN=
# 送信先のホスト（米国リージョン）。
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ===== Chatwoot（DD-02 の 4 節）=====
# ウィジェットの配信元と会話 API。開発は http://localhost:3100、本番は https://chat.comegin.com。
PUBLIC_CHATWOOT_BASE=http://localhost:3100
# Web サイトの受信箱の website_token（公開ページに埋め込む前提の値。DD-02 の 4.2）。
# Chatwoot の管理画面で受信箱を作ってから写す。未設定ならウィジェットを読み込まない。
PUBLIC_CHATWOOT_WEBSITE_TOKEN=

# ===== Mautic（DD-02 の 5 節）=====
# フォームの送信先。開発は http://localhost:8000、本番は https://mkt.comegin.com。
PUBLIC_MAUTIC_BASE=http://localhost:8000
# フォームの数値 ID（alias は consult。01-content-spec.md の 5.1 の F9）。
# Mautic でフォームを作ると採番される。PUBLIC_ を付けず、ビルド時に .astro で読んでフォームに渡す。
# 無料 DL のフォーム（source_dl）は 2026-10-20 に公開サイトから消したので、MAUTIC_FORM_ID_SOURCE_DL は要らない
MAUTIC_FORM_ID_CONSULT=

# ===== Cal.com（完了画面の予約枠。DD-02 の 7 節・ADR-24）=====
# 埋め込みの配信元（embed.js と予約ページのオリジン）。SaaS の cal.com なら https://app.cal.com。
PUBLIC_CALCOM_BASE=https://app.cal.com
# 予約するイベントのリンク（<ユーザー名>/<イベントの slug>）。Cal.com でイベントを作ってから写す。
# 未設定なら予約枠を出さず、代わりの案内（メールで日程を調整する）を出す。
PUBLIC_CALCOM_LINK=

# ===== 同意の受け口（consent-api。DD-02 の 8 節）=====
# consent-api のオリジン。開発は http://localhost:3104、本番は https://consent.comegin.com。
PUBLIC_CONSENT_BASE=http://localhost:3104
# 同意の Cookie（comegin_consent）の Domain 属性。consent-api の COOKIE_DOMAIN と同じ値にする。
# 開発（localhost）は空、本番は .comegin.com。値が違うと同じ名前の Cookie が 2 つでき、判定が割れる。
PUBLIC_CONSENT_COOKIE_DOMAIN=
# 現行のプライバシーポリシーの版（最終改定日。例 2026-10-01）。consent-api の CONSENT_POLICY_VERSION と同じ値にする。
# 同意の Cookie の版がこれと違えば、同意を取り直す。フォームの privacy_consent_version にも同じ値を送る。
CONSENT_POLICY_VERSION=

BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
