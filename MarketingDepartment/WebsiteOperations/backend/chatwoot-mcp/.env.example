# Chatwoot（本サーバ → Chatwoot: api_access_token ヘッダー）
# ブラウザで開く URL と同じ（chatwoot-system の CHATWOOT_PORT）
CHATWOOT_BASE_URL=http://localhost:3100
# プロフィール設定 > アクセストークン の値。操作はこのユーザーの権限・名前で行われる
CHATWOOT_API_ACCESS_TOKEN=
# URL の /app/accounts/<ID>/ の数字
CHATWOOT_ACCOUNT_ID=1

# 公開するツールの範囲
#   read_only  : 参照のみ（既定）
#   read_write : 作成・更新・メッセージ送信も
#   full       : 削除・コンタクトの統合も
CHATWOOT_ACCESS_LEVEL=read_only

# 日時の表示と、日付（YYYY-MM-DD）指定の解釈に使う UTC からの時差（時間）。日本は 9
CHATWOOT_TIMEZONE_OFFSET=9

# トランスポート: stdio（既定）| http
TRANSPORT=stdio

# --- 以下は TRANSPORT=http のときだけ使う ---
HOST=127.0.0.1
# 3100 は Chatwoot、3000 は Umami が使用
PORT=3102
# MCP クライアント → 本サーバの Bearer トークン（32 文字以上）
# 生成例: openssl rand -hex 32
MCP_AUTH_TOKEN=
# HOST=0.0.0.0 などで公開する場合に許可するホスト名（カンマ区切り）
# MCP_ALLOWED_HOSTS=mcp.example.com
