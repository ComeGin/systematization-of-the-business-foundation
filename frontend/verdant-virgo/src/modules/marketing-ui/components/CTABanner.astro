---
/**
 * 主 CTA のバナー（Figma の CTABanner）。ボタンは slot="cta" に CTAButton を置く（Mobile は fullWidth="mobile"）。
 * type=standard: セクション末尾。反転面 role/surface-brand-strong（navy.700）に白の文字、ボタンは Large。
 * type=inline: ブログ記事の中。白い面 ＋ 罫線の小型、ボタンは Default。
 * Desktop は横並び、Mobile は縦積み。地にアクセント色は使わない。文言の既定値は持たない（H-16）。
 */
import { cn } from '@/lib/utils';

interface Props {
  title: string;
  body?: string;
  type?: 'standard' | 'inline';
  /** 見出しの要素。記事の中の inline は本文の見出しの階層を崩さないよう p にしてよい */
  level?: 'h2' | 'h3' | 'p';
  class?: string;
}

const { title, body, type = 'standard', level = 'h2', class: className } = Astro.props;
const Heading = level;
const standard = type === 'standard';
---

<aside
  class={cn(
    'not-typeset flex flex-col items-start gap-4 md:flex-row md:items-center md:gap-8',
    standard
      ? 'rounded-xl bg-surface-brand-strong p-6 text-text-inverse md:p-12'
      : 'rounded-md border border-border bg-surface p-6',
    className,
  )}
>
  <div class="flex w-full min-w-0 flex-col gap-2 md:flex-1">
    <Heading class={cn(standard ? 'type-h2 text-text-inverse' : 'type-h4 text-text-heading')}>{title}</Heading>
    {body && <p class={cn('type-body phrase', standard ? 'text-text-inverse' : 'text-text-muted')}>{body}</p>}
  </div>
  <div class="w-full md:w-auto md:shrink-0">
    <slot name="cta" />
  </div>
</aside>
