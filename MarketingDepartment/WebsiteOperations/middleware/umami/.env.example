# Umami（開発環境）の設定
#
# このファイルは compose.yml と同じディレクトリに置く環境変数ファイル（.env）のひな形。
# .env は compose.yml 内の ${...} を展開するときの変数ソース（Compose 既定の env ファイル）になる。
#
# 秘密値は dev/init-env.sh が生成する。手で埋める必要はない:
#   ./dev/init-env.sh
# 空のままにしておけば同スクリプトが値を作って書き込む（既に値がある項目は変更しない）。

# セッション・トークンの署名鍵。変えると発行済みのログイン・トークンがすべて無効になる
APP_SECRET=

# 2 要素認証の秘密を暗号化する鍵（64 桁の hex。openssl rand -hex 32）。
# 変えると、登録済みの 2 要素認証を復号できなくなる
TWO_FACTOR_ENCRYPTION_KEY=

# PostgreSQL のパスワード。DB ボリュームの初期化時にしか反映されない。
# 後から変えるなら DB 側で ALTER USER を実行するか、ボリュームを作り直す
POSTGRES_PASSWORD=
