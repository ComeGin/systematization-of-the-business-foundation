---
// Strapi のメディアを <Image> でビルド時に取り込む（ADR-11・DD-05 の 1.5.2）。
// 寸法は Strapi の width / height を渡す（inferSize を使わない）。派生サイズ（formats）は使わず、srcset は Astro に作らせる。
// 取り込みに失敗すると <Image> がビルドを失敗させる。
import { Image } from 'astro:assets';
import { mediaAlt, toAbsoluteMediaUrl } from '../lib/media';
import type { StrapiMedia } from '../lib/types';

interface Props {
  media: StrapiMedia;
  /** alt が空のときの記録に使う（どの画像か） */
  context: string;
  sizes?: string;
  widths?: number[];
  loading?: 'eager' | 'lazy';
  class?: string;
}

const { media, context, sizes = '(min-width: 768px) 720px, 100vw', widths = [360, 720, 1440], loading = 'lazy', class: className } =
  Astro.props;
const src = toAbsoluteMediaUrl(media.url);
const alt = mediaAlt(media.alternativeText, context);
---

{
  media.width && media.height ? (
    <Image src={src} width={media.width} height={media.height} alt={alt} sizes={sizes} widths={widths} format="webp" loading={loading} class={className} />
  ) : (
    <Image src={src} inferSize alt={alt} sizes={sizes} widths={widths} format="webp" loading={loading} class={className} />
  )
}
