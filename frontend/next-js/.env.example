# 監視アプリ（next-js + control-plane）の環境変数（正本）。127.0.0.1:3200 にだけバインドする。開発では ngrok から開いてよい（ADR-23。ログインは Google だけ）。
# 秘密値は空欄のままコミットする。値を設定するのは人間だけ。
# control-plane の変数の説明は backend/control-plane/.env.example と README.md を参照。

# ---- 監視アプリのログイン（Better Auth。Google だけ。ADR-23） ----
# 32 文字以上のランダムな文字列（dev/init-env.sh が生成する）
BETTER_AUTH_SECRET=
# 監視アプリを開く URL。ブラウザで開く URL と同じにする（Google の承認済みのリダイレクト URI は <この URL>/api/auth/callback/google）。
# 開発で ngrok から開くなら、その URL（例 https://comegin-next-js-dev.ngrok.app）。next.config.ts がそのホストを allowedDevOrigins に入れる
BETTER_AUTH_URL=http://127.0.0.1:3200
# Google の OAuth クライアント（ウェブ アプリケーション。ユーザーの種類は「内部」）。setup/manual-steps.md の 7.2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Workspace のドメイン（ID トークンの hd と照合する。既定 comegin.com）
GOOGLE_HOSTED_DOMAIN=comegin.com
# ログインを許すメールアドレス（カンマ区切り）。空ならだれもログインできない
CONTROL_ADMIN_EMAILS=

# ---- control-plane（中核。必須） ----
# E-15 の SQLite（e15.sqlite）・ログイン用の SQLite（auth.sqlite）の置き場。作業ツリーの外にすること
# （未設定なら ~/.local/share/comegin-control）
CONTROL_DATA_DIR=
# 承認済み main の別チェックアウト（絶対パス）。エージェント定義・ops/ をここから読む
CONTROL_MAIN_CHECKOUT=
# 作業ツリー（絶対パス）。エージェントの cwd。docs/audits・docs/proposals を書く場所
CONTROL_WORKTREE=
# 定期実行を動かすか（true / false）。既定 false。dev で誤って定期実行しないため
CONTROL_SCHEDULER_ENABLED=false
# SDK の子プロセスに HOME として渡すディレクトリ（空なら実ホーム）
CONTROL_AGENT_HOME=

# ---- エージェントに渡す唯一の秘密値 ----
ANTHROPIC_API_KEY=

# ---- Lighthouse CI（builtin lighthouse）の計測対象 URL。main のチェックアウトで動かす子プロセスに渡す ----
SITE_URL=

# ---- I-13 の起票（グループ。1 つでも設定したら 4 つとも必須） ----
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
I13_ISSUE_NUMBER=
I13_REVIEWER=

# ---- S3 への写しとハートビート（グループ。AWS_REGION と RUNLOG_BUCKET は両方必須） ----
AWS_REGION=
AWS_PROFILE=
RUNLOG_BUCKET=
HEARTBEAT_NAMESPACE=ComeGin/Onprem

# ---- 誤った書き込みの突き合わせ（グループ。4 つとも必須。参照専用トークン） ----
MISWRITE_CHATWOOT_BASE_URL=
MISWRITE_CHATWOOT_ACCOUNT_ID=
MISWRITE_CHATWOOT_API_TOKEN=
MISWRITE_AGENT_USER_ID=

# ---- n8n のワークフローの書き出し（builtin n8n-export。2 つ揃ったときだけ有効。片方だけなら skipped） ----
# 本番の n8n の Public API の URL（オンプレの本番は http://127.0.0.1:5679。ADR-21）
CONTROL_N8N_EXPORT_URL=
# 本番の n8n の API キー。読み取りだけに使う（必要なスコープは workflow:list と workflow:read）。
# **スコープを付けられるのは n8n の Enterprise だけ。コミュニティ版のキーはアカウントの全権限（ワークフロー・資格情報・実行の作成・更新・削除）を持つ**
# ので、この監視アプリの env にだけ置く。エージェントには渡らない。有効化の前に、本番の n8n の版を確かめて人が判断する
# （代案の CLI〈docker exec〉は監視アプリに docker の権限が要るので採らない）。書き出しには GITHUB_* の 4 変数（I-13 と同じ）も要る
CONTROL_N8N_EXPORT_API_KEY=
