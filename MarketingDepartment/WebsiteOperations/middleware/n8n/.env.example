# n8n（Web サイト運用・SEO 対策のワークフロー基盤）の設定
#
# このファイルは compose.yml と同じディレクトリに置く .env のひな形。
# .env は 2 つの役割を同時に持つ:
#   1. compose.yml 内の ${...} を展開するときの変数ソース（Compose 既定の env ファイル）
#   2. env_file: .env を書いたサービスへの環境変数の注入
#   ※ 1 が欠けると ${N8N_VERSION} が空文字列になり「n8nio/n8n:」という不正なイメージ名になる
#
# 秘密値は dev/init-env.sh が生成する。手で埋める必要はない:
#   ./dev/init-env.sh
# 空のままにしておけば同スクリプトが値を作って書き込む（既に値がある項目は変更しない）。

# ===== Compose / イメージ =====
# n8n 本体と runners サイドカーの両方に使う。両者のバージョンは必ず一致させること
# 更新するときは https://github.com/n8n-io/n8n/releases を確認する
N8N_VERSION=2.39.5

# ===== n8n 本体 =====
# 保存済みクレデンシャルの暗号化キー。未設定だと初回起動時に自動生成され
# n8n-data ボリューム内の config に保存されるが、ボリュームを作り直すと
# 既存クレデンシャルが復号できなくなるため、明示的に固定してバックアップしておく
N8N_ENCRYPTION_KEY=

# 既定は America/New_York。スケジュールトリガーの実行時刻に効く
GENERIC_TIMEZONE=Asia/Tokyo
TZ=Asia/Tokyo

# ブラウザから開くホスト側ポート（3000=Umami / 3100=Chatwoot と衝突しない値）
N8N_PORT_HOST=5678

# ===== Webhook の公開 URL（ngrok などのトンネル利用時）=====
# n8n は既定で N8N_PROTOCOL + N8N_HOST + N8N_PORT から Webhook URL を組み立てるため、
# リバースプロキシやトンネル越しでは実際の公開 URL と食い違う。
# トンネルを張ったら 2 行のコメントを外し、URL を払い出されたものに差し替えて
#   docker compose up -d n8n
# で反映する（末尾のスラッシュを含める）。
# N8N_WEBHOOK_URL は n8n 2.35.0 で WEBHOOK_URL を置き換えた新しい名前
#N8N_WEBHOOK_URL=https://xxxxxxxx.ngrok-free.app/
#N8N_PROXY_HOPS=1

# ===== タスクランナー（external モード）=====
# Code ノードのユーザーコードを別コンテナで実行する。公式は本番では external を必須としている
N8N_RUNNERS_MODE=external
# n8n（ブローカー）と runners コンテナの共有シークレット
N8N_RUNNERS_AUTH_TOKEN=
# ブローカーの待ち受けアドレス。既定の 127.0.0.1 のままだと別コンテナの runners から接続できない
N8N_RUNNERS_BROKER_LISTEN_ADDRESS=0.0.0.0

# ----- 将来の既定値変更（起動時に deprecation として警告が出る項目）-----
# いずれも「将来のバージョンで既定値が変わる」という予告。安全側に倒すなら未設定のまま新しい
# 既定値を受け入れ、現在の挙動を維持したい場合だけコメントを外して明示する
#N8N_UNVERIFIED_PACKAGES_ENABLED=true          # 未検証のコミュニティノードの導入可否（既定が false になる）
#N8N_RUNNERS_TASK_TIMEOUT=300                  # Code ノードの実行上限秒（既定が 300 → 60 になる）
#N8N_COMPRESSION_NODE_MAX_DECOMPRESSED_SIZE_BYTES=2147483648  # 展開サイズ上限（既定が 2GiB → 256MiB になる）
#N8N_COMPRESSION_NODE_MAX_ZIP_ENTRIES=5000     # ZIP のエントリ数上限（既定が 5000 → 1000 になる）

# ===== PostgreSQL =====
# 既定の SQLite はコンテナ内蔵で、ワークフローが増える運用には向かないため Postgres を使う
POSTGRES_USER=n8n
POSTGRES_PASSWORD=
POSTGRES_DB=n8n
# ホスト側の公開ポート。5432 は Chatwoot の Postgres が使っているのでずらす
POSTGRES_HOST_PORT=5433

# ===== サンドボックス（n8n Assistant が生成コードを隔離実行する基盤）=====
# sandbox-api が受け付ける API キーの一覧（カンマ区切り）
SANDBOX_API_KEYS=
# sandbox-runner-1 が sandbox-api に登録するときのトークン
SANDBOX_API_RUNNER_REGISTRATION_TOKEN=
# sandbox-runner-1 が sandbox-api を呼ぶときの API キー
SANDBOX_API_RUNNER_API_KEY=
# n8n が sandbox-api を呼ぶときのキー。SANDBOX_API_KEYS のいずれかの値と一致させること
N8N_SANDBOX_SERVICE_API_KEY=

# ===== Web 検索（n8n Assistant が最新のドキュメントや API を参照する）=====
SEARXNG_SECRET=
N8N_INSTANCE_AI_SEARXNG_URL=http://searxng:8080

# ===== n8n Assistant のモデル（任意・後から UI でも設定できる）=====
# Anthropic / OpenAI / OpenRouter などのキー。設定するとプロンプトと実行データが
# そのプロバイダに送られる点に注意する
#N8N_INSTANCE_AI_MODEL_API_KEY=
# Brave Search を使う場合。設定すると SearXNG より優先される
#INSTANCE_AI_BRAVE_SEARCH_API_KEY=
