---
/**
 * 料金カード（料金 4-4 ×5、サービス詳細 3-4 ×2。Figma の PricingCard）。料金表（01-content-spec.md §2）の 1 行 ＝ 1 枚。
 * 上: バッジ・プロダクト名・説明・金額・「期間」と値・備考・罫線。下: 主ボタン（slot="cta"。CTAButton fullWidth）と副リンク（slot="sub-link"）。
 * 上と下のあいだに余白は入れない（Figma は SPACE_BETWEEN で、内容の高さで組むと罫線の直下に主ボタン）。
 * バッジとプロダクト名は同じ行に置き、幅が足りなければバッジが上の行に来る（見出しの最小幅 260px）。
 * 値は §2 の表から一字一句写す。既定値は持たない（H-16）。カード群の直下に「表示価格はすべて税込です。」を別に置く。
 */
import { Badge } from '@/components/ui/badge';
import { cn } from '@/lib/utils';
import type { HeadingLevel } from '../lib/types';

interface Props {
  product: string;
  badge?: string;
  description?: string;
  /** 金額（「要相談」も可） */
  price: string;
  /** 期間の値（業務提携は「—」） */
  period: string;
  note?: string;
  level?: HeadingLevel;
  class?: string;
}

const { product, badge, description, price, period, note, level = 'h3', class: className } = Astro.props;
const Heading = level;
---

<article class={cn('flex flex-col justify-between rounded-md border border-border bg-surface p-6', className)}>
  <div class="flex flex-col gap-4">
    <div class="flex flex-col gap-2">
      <div class="flex flex-wrap items-center gap-3">
        {badge && <Badge variant="secondary">{badge}</Badge>}
        <Heading class="type-card-title min-w-[260px] flex-1 text-text-heading">{product}</Heading>
      </div>
      {description && <p class="type-small phrase text-text-muted">{description}</p>}
    </div>
    <div class="flex flex-col gap-1">
      <p class="type-price text-text-body">{price}</p>
      <p class="flex items-baseline gap-2">
        <span class="type-small text-text-muted">期間</span>
        <span class="type-label text-text-body">{period}</span>
      </p>
    </div>
    {note && <p class="type-small phrase text-text-body">{note}</p>}
    <hr class="border-border" />
  </div>
  <div class="flex flex-col items-center gap-4">
    <slot name="cta" />
    <slot name="sub-link" />
  </div>
</article>
