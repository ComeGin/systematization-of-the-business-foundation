---
// 無料相談の「業務棚卸しの内容」の 1 枚（01-content-spec.md §4.6 の 6-3）。
// Figma では手組みのカード（42:132）で、実装では 1 つの部品にする（03-handoff.md §0.3）。
// 所要時間は role/text-heading の H3 相当、名前は Card Title、説明は本文（Body・role/text-body）。
// ファイル名の先頭の _ でページにならない（Astro のルーティングの対象外）。
interface Props {
  duration: string;
  title: string;
  body: string;
}

const { duration, title, body } = Astro.props;
---

<article class="flex flex-col items-start gap-2 rounded-md border border-border bg-surface p-6">
  <p class="type-h3 text-text-heading">{duration}</p>
  <h3 class="type-card-title text-text-heading">{title}</h3>
  <p class="type-body phrase text-text-body">{body}</p>
</article>
