---
/**
 * サイト共通のヘッダー（01-content-spec.md §1.3、Figma の SiteHeader）。
 * 高さ 56px（シンボル 35.79×32 ＋ 上下 12px）。下端は 1px の罫線（高さに含める）。
 * Desktop: ロゴ ＋ ナビ 4 つ ＋「無料相談」（Small）。Mobile: ロゴ ＋ ハンバーガー（Sheet の中に無料相談）。
 * 「無料相談」の強さはブログ一覧・記事だけ Outline（headerCta）。ヘッダーの無料相談は主 CTA の数に入れない。
 * Desktop のナビは motion の MotionNav（GooeyNav。SSR で <nav>・<a>・aria-current が出る。Desktop だけ水和）。
 * ページ遷移で現在地の形を次のページへつなぐため、ヘッダーに view-transition-name: site-header を付ける（global.css の @view-transition）。
 */
import { Logo } from '@/modules/brand';
import { CTAButton } from '@/modules/marketing-ui';
import { MotionNav } from '@/modules/motion';
import { contactHref, ctaDataAttributes } from '@/modules/site-content/cta';
import { headerCta, headerNav, sheetSourceDl } from '@/modules/site-content/nav';
import type { HeaderCta } from '../lib/types';
import { currentState } from '../lib/path';
import MobileMenuSheet from './MobileMenuSheet.astro';

interface Props {
  headerCta: HeaderCta;
  /** ページの中に無料 DL ブロック（#source-dl）があるか。無ければ Sheet の DL はトップの #source-dl へ */
  sourceDlOnPage: boolean;
}

const { headerCta: ctaStrength, sourceDlOnPage } = Astro.props;
const path = Astro.url.pathname;

const links = headerNav.map((link) => ({ ...link, current: currentState(path, link.href) }));
const consultHref = (ctaId: typeof headerCta.desktopCtaId | typeof headerCta.sheetCtaId) => contactHref({ cta: ctaId, from: path });
---

<header class="h-14 border-b border-border bg-surface [view-transition-name:site-header]">
  <div class="site-container flex h-full items-center justify-between">
    <a href="/" class="-m-1 rounded-md p-1">
      <Logo lockup="symbol" height={32} eager />
    </a>

    <div class="hidden items-center gap-6 md:flex">
      <MotionNav links={links.map(({ label, href, current }) => ({ label, href, current }))} label="メイン" />
      <CTAButton
        ctaId={headerCta.desktopCtaId}
        href={consultHref(headerCta.desktopCtaId)}
        variant={ctaStrength === 'primary' ? 'primary' : 'outline'}
        size="sm"
      >
        {headerCta.label}
      </CTAButton>
    </div>

    <div class="-mr-1.5 md:hidden">
      <MobileMenuSheet
        links={links}
        consult={{
          label: headerCta.label,
          href: consultHref(headerCta.sheetCtaId),
          attrs: ctaDataAttributes(headerCta.sheetCtaId),
          variant: ctaStrength,
        }}
        sourceDl={{
          label: sheetSourceDl.label,
          href: sourceDlOnPage ? '#source-dl' : '/#source-dl',
          attrs: ctaDataAttributes(sheetSourceDl.ctaId),
        }}
      />
    </div>
  </div>
</header>
