                "operation": "equals"
              },
              "rightValue": "={{ $json.receivedDigest }}"
            }
          ],
          "combinator": "and"
        }
      },
      "id": "07470a79-10a9-5b9f-9496-d65c629f8261",
      "name": "署名が正しいか",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        896,
        96
      ],
      "notes": "ヘッダーが無い場合（Mautic の Webhook に Secret を設定していない場合）も、ここで 401 になる。"
