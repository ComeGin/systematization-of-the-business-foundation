# --- 待ち受け ---
# コンテナの中では 0.0.0.0（compose が上書きする）。pnpm dev で直接動かすときは 127.0.0.1 にしておく
HOST=127.0.0.1
# 3103 は admin-auth 用
PORT=3103
# production にすると GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET が必須になる。Docker イメージは production、compose は development で動かす
NODE_ENV=development

# --- Better Auth ---
# ブラウザで開く URL（OIDC の issuer になる。ALB の設定値もここから決まる）。本番は https://auth.comegin.com
BETTER_AUTH_URL=http://localhost:3103
# セッション・OAuth トークンの署名と暗号化に使う（32 文字以上）。dev/init-env.sh が生成する
# ※ 変えると既存のセッションと、暗号化して DB に置いた値（JWKS の秘密鍵など）が使えなくなる
BETTER_AUTH_SECRET=

# --- PostgreSQL（DB 名 admin_auth。本番は RDS の 1 インスタンスに相乗り）---
# 開発（compose）のホスト名は postgres（compose が上書きする）
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=admin_auth
DATABASE_USERNAME=admin_auth
# dev/init-env.sh が生成する。※ 開発の DB ボリュームの初期化時にだけ反映される
DATABASE_PASSWORD=
# RDS では true（証明書を検証する）。開発は false
DATABASE_SSL=false

# --- Google ログイン（Google Cloud の OAuth クライアント。ユーザータイプは「内部」）---
# 承認済みのリダイレクト URI: <BETTER_AUTH_URL>/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# ID トークンの hd クレームと照合する Workspace のドメイン
GOOGLE_HOSTED_DOMAIN=comegin.com
# 管理者の許可リストの初期値（カンマ区切り）。起動時に表へ追加するだけで、削除はしない。以後の追加・削除は README の SQL で行う
ADMIN_BOOTSTRAP_EMAILS=

# --- ALB を信頼済みクライアントとして登録するスクリプト（pnpm alb:register）だけが使う ---
# ALB の OIDC クライアント。ALB のリスナールールと同じ値を渡す（本番は Secrets Manager の同じ Secret から）
ALB_CLIENT_ID=
ALB_CLIENT_SECRET=
# /oauth2/idpresponse を登録するホスト（カンマ区切り。ホスト名だけ）。
# 例: chat.comegin.com,mkt.comegin.com,stats.comegin.com（ADR-21 で cms.・n8n.、ADR-24 で cal. は対象外になった）
ALB_PROTECTED_HOSTS=
