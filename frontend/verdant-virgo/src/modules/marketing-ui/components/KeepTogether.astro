---
/**
 * 文字列を出し、その中の「分けない語」（words）だけを whitespace-nowrap の span で包む（03-handoff.md H-18）。
 * 文節の折り返し（phrase）でも語の途中で切れるときに使う。データの文字列は変えない。set:html は使わない。
 */
import { splitKeepTogether } from '../lib/keep-together';

interface Props {
  text: string;
  words?: readonly string[];
}

const { text, words } = Astro.props;
const pieces = splitKeepTogether(text, words);
---

{pieces.map((piece) => (piece.keep ? <span class="whitespace-nowrap">{piece.text}</span> : piece.text))}
