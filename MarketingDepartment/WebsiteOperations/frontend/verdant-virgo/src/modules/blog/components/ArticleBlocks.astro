---
// 記事本文の描画（01-content-spec.md §4.8 の 8-5。dynamic zone の rich-text・quote・media・slider）。
// 記事中 CTA（8-6）は slot "inline-cta" で受け取り、最初の h2 の直前（リード文のすぐ後）に置く。
// slot は not-typeset の枠で包み、本文の見た目を受けないかわりに上下 32px の余白をここで取る。
// h2 が無い記事では本文の後に置く。
// slider は JS を使わず、画像を縦に並べる（計画書 P-4）。
import StrapiImage from './StrapiImage.astro';
import type { PreparedBlock, PreparedBody } from '../lib/body';

interface Props {
  body: PreparedBody;
  /** alt の記録に使う */
  slug: string;
  class?: string;
}

const { body, slug, class: className } = Astro.props;
const groups: PreparedBlock[][] = [body.lead, body.rest];
---

<div class:list={['typeset', className]}>
  {
    groups.map((blocks, index) => (
      <>
        {index === 1 && Astro.slots.has("inline-cta") && <div class="not-typeset my-8"><slot name="inline-cta" /></div>}
        {blocks.map((block) =>
          block.kind === 'html' ? (
            <Fragment set:html={block.html} />
          ) : block.kind === 'quote' ? (
            <blockquote>
              <p>{block.body}</p>
              {block.title && <footer>{block.title}</footer>}
            </blockquote>
          ) : block.kind === 'media' ? (
            <figure>
              <StrapiImage media={block.media} context={`記事「${slug}」の media`} />
            </figure>
          ) : (
            <div class="grid gap-4">
              {block.media.map((media) => (
                <figure>
                  <StrapiImage media={media} context={`記事「${slug}」の slider`} />
                </figure>
              ))}
            </div>
          ),
        )}
      </>
    ))
  }
</div>
