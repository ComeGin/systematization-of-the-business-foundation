---
// 無料相談フォームの差し込み口（/contact の 6-4）。フォーム ID と同意の版をビルド時に読み、island に渡す。
import ContactForm from './ContactForm';
import { readFormId, readPolicyVersion } from '../lib/build-config';

const formId = readFormId('MAUTIC_FORM_ID_CONSULT');
const policyVersion = readPolicyVersion();
---

<ContactForm client:load formId={formId} policyVersion={policyVersion} />
