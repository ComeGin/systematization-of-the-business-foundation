---
/**
 * サービスのカード（トップ 1-7、サービス一覧 2-4。Figma の ServiceCard）。
 * 上: 見出し（＋バッジ）・本文・価格の枠（1〜2 行と注記）。下: 「詳しく見る」と副リンク（slot="sub-link"）。
 * 横に並べて高さをそろえるときは、親の grid に置くだけでよい（ボタンは下端でそろう）。
 * 上と下のあいだに余白は入れない（Figma は SPACE_BETWEEN で、内容の高さで組むと間隔 0）。
 * 価格の値は 01-content-spec.md §2 の表から一字一句写す（site-content/pricing.ts）。既定値は持たない（H-16）。
 * カード群の直下に「表示価格はすべて税込です。」を別に置く（この部品には含めない）。
 * 「詳しく見る」はカードごとに同じ文字なので、detailTarget（区切りを含めた対象名。site-content/a11y.ts で作る）を sr-only で後ろに足し、
 * 「詳しく見る：環境構築」と読ませる（2.4.4。見える文字で始まるので 2.5.3 も満たす）。区切りの文字は部品に持たせない（H-16・H-31）。
 */
import { ArrowRight } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { VisuallyHidden } from '@/modules/a11y';
import type { HeadingLevel, PriceRow } from '../lib/types';

interface Props {
  title: string;
  badge?: string;
  body: string;
  /** 1〜2 行（受託開発だけ 2 行） */
  prices: [PriceRow] | [PriceRow, PriceRow];
  note?: string;
  detailHref: string;
  /** 詳細へのリンクの文言（CTA ではないリンク。Figma の全カードで「詳しく見る」） */
  detailLabel?: string;
  /** 「詳しく見る」の後ろに sr-only で足す対象名（区切りを含む。01-content-spec.md §12 の S-3） */
  detailTarget?: string;
  level?: HeadingLevel;
  class?: string;
}

const { title, badge, body, prices, note, detailHref, detailLabel = '詳しく見る', detailTarget, level = 'h3', class: className } = Astro.props;
const Heading = level;
---

<article class={cn('flex flex-col justify-between rounded-md border border-border bg-surface p-6', className)}>
  <div class="flex flex-col gap-4">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2">
      <Heading class="type-card-title text-text-heading">{title}</Heading>
      {badge && <Badge variant="secondary">{badge}</Badge>}
    </div>
    <p class="type-small phrase text-text-body">{body}</p>
    <div class="flex flex-col gap-3 rounded-md border border-border bg-surface p-4">
      <dl class="flex flex-col gap-3">
        {
          prices.map((row) => (
            <div class="flex flex-col gap-1">
              <dt class="type-caption phrase text-text-muted">{row.product}</dt>
              <dd class="flex flex-wrap items-baseline gap-x-2">
                <span class="text-xl leading-normal font-bold text-text-body">{row.price}</span>
                <span class="type-small text-text-muted">{row.period}</span>
              </dd>
            </div>
          ))
        }
      </dl>
      {note && <p class="type-caption phrase text-text-muted">{note}</p>}
    </div>
  </div>
  <div class="flex flex-wrap items-start gap-x-4 gap-y-2">
    <a href={detailHref} class={buttonVariants({ variant: 'link', size: 'default' })}>
      {detailLabel}
      {detailTarget && <VisuallyHidden>{detailTarget}</VisuallyHidden>}
      <ArrowRight aria-hidden="true" data-icon="inline-end" />
    </a>
    <slot name="sub-link" />
  </div>
</article>
