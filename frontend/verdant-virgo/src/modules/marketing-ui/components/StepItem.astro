---
/**
 * 番号付きの手順の 1 段（Figma の StepItem）。ふつうは Steps が並べる。
 * layout=stacked: 番号の下に見出し・本文（横並びの Steps）。inline: 番号の右に見出し・本文（縦並びの Steps）。
 * 番号と見出しは UI/Card Title（20px）。期間は見出しの直下に Caption。見出しだけの手順では全段そろえて body を省く。
 */
import { cn } from '@/lib/utils';
import type { HeadingLevel } from '../lib/types';
import KeepTogether from './KeepTogether.astro';

interface Props {
  number: number;
  title: string;
  body?: string;
  period?: string;
  /** 本文の中で途中で改行させない語 */
  keepTogether?: readonly string[];
  layout?: 'stacked' | 'inline';
  level?: HeadingLevel;
  class?: string;
}

const { number, title, body, period, keepTogether, layout = 'stacked', level = 'h3', class: className } = Astro.props;
const Heading = level;
---

<div class={cn('flex items-start', layout === 'inline' ? 'gap-4' : 'flex-col gap-3', className)}>
  <span
    aria-hidden="true"
    class="type-card-title flex size-10 shrink-0 items-center justify-center rounded-full bg-surface-accent-subtle text-text-accent-subtle"
  >
    {number}
  </span>
  <div class={cn('flex min-w-0 flex-col gap-2', layout === 'inline' ? 'flex-1' : 'w-full')}>
    <Heading class="type-card-title text-text-heading">{title}</Heading>
    {period && <p class="type-caption phrase text-text-muted">{period}</p>}
    {body && <p class="type-small phrase text-text-muted"><KeepTogether text={body} words={keepTogether} /></p>}
  </div>
</div>
