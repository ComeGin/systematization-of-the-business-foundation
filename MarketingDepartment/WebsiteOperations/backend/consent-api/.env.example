# --- 待ち受け ---
# コンテナの中では 0.0.0.0（compose が上書きする）。pnpm dev で直接動かすときは 127.0.0.1 にしておく
HOST=127.0.0.1
# 3104 は consent-api 用（3100 は Chatwoot、3102 は chatwoot-mcp）
PORT=3104

# --- Valkey（同意の記録の保存先。DB は持たない）---
# 開発（compose）は redis://valkey:6379（compose が上書きする）。本番は ElastiCache の rediss://<endpoint>:6379
VALKEY_URL=redis://valkey:6379
# AUTH トークン。開発は空でよい。本番は Secrets Manager から注入する
VALKEY_PASSWORD=
# Chatwoot・Mautic とキーを分けるための接頭辞
VALKEY_KEY_PREFIX=consent:

# --- 公開サイトとの関係 ---
# CORS で許す公開サイトのオリジン（1 つだけ。パスは付けない）。Astro の dev は http://localhost:4321、本番は https://comegin.com
SITE_URL=http://localhost:4321
# Cookie の Domain 属性。本番は .comegin.com。開発（localhost）は空にして Domain を付けない
COOKIE_DOMAIN=

# --- 同意の文面 ---
# 現行のプライバシーポリシー・Cookie 文面の版（最終改定日）。記録と Cookie に入る。クライアントが送る値は信用しない
CONSENT_POLICY_VERSION=2026-10-01
