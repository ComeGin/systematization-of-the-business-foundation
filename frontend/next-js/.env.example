# 監視アプリ（next-js + control-plane）の環境変数（正本）。127.0.0.1:3200 にだけバインドする。開発では ngrok から開いてよい（ADR-23。ログインは Google だけ）。
# 秘密値は空欄のままコミットする。値を設定するのは人間だけ。
# control-plane の変数の説明は backend/control-plane/.env.example と README.md を参照。

# ---- 監視アプリのログイン（Better Auth。Google だけ。ADR-23） ----
# 32 文字以上のランダムな文字列（dev/init-env.sh が生成する）
BETTER_AUTH_SECRET=
# 監視アプリを開く URL。ブラウザで開く URL と同じにする（Google の承認済みのリダイレクト URI は <この URL>/api/auth/callback/google）。
# 開発で ngrok から開くなら、その URL（例 https://comegin-next-js-dev.ngrok.app）。next.config.ts がそのホストを allowedDevOrigins に入れる
BETTER_AUTH_URL=http://127.0.0.1:3200
# Google の OAuth クライアント（ウェブ アプリケーション。ユーザーの種類は「内部」）。setup/manual-steps.md の 7.2
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Workspace のドメイン（ID トークンの hd と照合する。既定 comegin.com）
GOOGLE_HOSTED_DOMAIN=comegin.com
# ログインを許すメールアドレス（カンマ区切り）。空ならだれもログインできない
CONTROL_ADMIN_EMAILS=

# ---- control-plane（中核。必須） ----
# E-15 の SQLite（e15.sqlite）・ログイン用の SQLite（auth.sqlite）の置き場。作業ツリーの外にすること
# （未設定なら ~/.local/share/comegin-control）
CONTROL_DATA_DIR=
# 承認済み main の別チェックアウト（絶対パス）。エージェント定義・ops/ をここから読む
CONTROL_MAIN_CHECKOUT=
# 作業ツリー（絶対パス）。エージェントの cwd。docs/audits・docs/proposals を書く場所
CONTROL_WORKTREE=
# 定期実行を動かすか（true / false）。既定 false。dev で誤って定期実行しないため
CONTROL_SCHEDULER_ENABLED=false
# SDK の子プロセスに HOME として渡すディレクトリ（空なら実ホーム）
CONTROL_AGENT_HOME=

# 改善ループの周（14 日）の起点。JST の月曜の日付（YYYY-MM-DD。例 2026-11-16）。空なら cycle_days のジョブと cycle-open・cycle-collect・cycle-close は skipped
CONTROL_CYCLE_ANCHOR=
# cycle-open が周の始まりに作業場を origin/main に合わせるか（true / false）。既定 true。docs/audits・docs/proposals・docs/cycles の未追跡のファイル以外の変更があるとき・作業場が名前のあるブランチにいるときは合わせない。開発の設定スクリプト（setup/index.mjs）は空なら false を書く
CONTROL_WORKTREE_SYNC=

# ---- エージェントに渡す唯一の秘密値 ----
ANTHROPIC_API_KEY=

# ---- 公開サイトの URL（本番は https://comegin.com。campaign-planner と published-article-check では必須） ----
# Lighthouse CI・a11y・配信用のビルドの子プロセス（main のチェックアウトで動かす）に渡し、エージェントのプロンプトの末尾に `SITE_URL: <URL>` の行を足す
# （campaign-planner はこの行が無いと何も作らずに止まる。メールのリンクと plugin.json の homepage に使う）。published-article-check は無ければ skipped
SITE_URL=

# ---- I-13 の起票（グループ。1 つでも設定したら 4 つとも必須） ----
GITHUB_TOKEN=
GITHUB_REPOSITORY=
GITHUB_BASE_BRANCH=main
I13_ISSUE_NUMBER=
I13_REVIEWER=

# ---- S3 への写しとハートビート（グループ。AWS_REGION と RUNLOG_BUCKET は両方必須） ----
# 本番（setup/00-setup-overview.md の P14）は、AWS_REGION=ap-northeast-1・RUNLOG_BUCKET=comegin-prod-runlog-archive-<アカウント ID>。
# 資格情報は IAM ユーザー comegin-prod-control-plane（管理ポリシー comegin-prod-control-plane だけ）のキー。cloud/README.md の 4.5.2
AWS_REGION=
# 資格情報ファイルの節の名前（本番は comegin-prod-control-plane）
AWS_PROFILE=
# 監視アプリだけが読む資格情報ファイル（絶対パス。例 /home/<ユーザー>/.config/comegin/control-plane/aws-credentials）。
# AWS SDK が読む標準の変数。空なら ~/.aws/credentials を読む（管理者のキーと混ざるので、本番では空にしない）。キーの値はここに書かない
AWS_SHARED_CREDENTIALS_FILE=
RUNLOG_BUCKET=
HEARTBEAT_NAMESPACE=ComeGin/Onprem

# ---- 誤った書き込みの突き合わせ（グループ。4 つとも必須。参照専用トークン） ----
MISWRITE_CHATWOOT_BASE_URL=
MISWRITE_CHATWOOT_ACCOUNT_ID=
MISWRITE_CHATWOOT_API_TOKEN=
MISWRITE_AGENT_USER_ID=

# ---- n8n のワークフローの書き出し（builtin n8n-export。2 つ揃ったときだけ有効。片方だけなら skipped） ----
# 本番の n8n の Public API の URL（オンプレの本番は http://127.0.0.1:5679。ADR-21）
CONTROL_N8N_EXPORT_URL=
# 本番の n8n の API キー。読み取りだけに使う（必要なスコープは workflow:list と workflow:read）。
# **スコープを付けられるのは n8n の Enterprise だけ。コミュニティ版のキーはアカウントの全権限（ワークフロー・資格情報・実行の作成・更新・削除）を持つ**
# ので、この監視アプリの env にだけ置く。エージェントには渡らない。有効化の前に、本番の n8n の版を確かめて人が判断する
# （代案の CLI〈docker exec〉は監視アプリに docker の権限が要るので採らない）。書き出しには GITHUB_* の 4 変数（I-13 と同じ）も要る
CONTROL_N8N_EXPORT_API_KEY=

# ---- 本番の Strapi（builtin published-article-check の読み取りと、article-cover・campaign-asset-upload の書き込み。URL と読み取りトークンはグループ。両方空なら published-article-check は skipped） ----
# 本番の Strapi の URL（オンプレの本番は http://127.0.0.1:1338。ADR-21。開発の Strapi を指すと配信用のビルドが止まる）
CONTROL_STRAPI_URL=
# 読み取り専用の API トークン（権限は article の find / findOne。下書きを読むため、記事の下書きも読める権限にする）。配信用のビルドの STRAPI_API_TOKEN にもなる
CONTROL_STRAPI_READ_TOKEN=
# 書き込み用の API トークン（任意。アイキャッチの設定・配布ファイルのアップロードだけに使う。無ければ書き込みの builtin は skipped）。記事の公開の権限は付けない
CONTROL_STRAPI_WRITE_TOKEN=

# ---- アイキャッチ画像の生成（builtin article-cover。OpenAI の Images API。キーが空なら article-cover は skipped。書き込み用の Strapi トークンも要る。エージェントには渡さない） ----
OPENAI_API_KEY=
# 画像のモデル（任意。既定 gpt-image-2.5-sunburst。2026-11-09 に OpenAI の公式ドキュメントで確認。速度重視なら gpt-image-2.5-flare）
CONTROL_OPENAI_IMAGE_MODEL=
# 画像のサイズ（任意。既定 1536x1024 の横長。幅x高さ）
CONTROL_OPENAI_IMAGE_SIZE=
# 1 回の実行で作る枚数の上限（任意。既定 3。1〜10。費用の上限）
CONTROL_COVER_MAX_PER_RUN=

# ---- 配信（deploy の項目に出す aws のコマンドへ埋める値。3 つともグループ。control-plane は配信を実行しない。cloud/README.md の 4.14） ----
# 親スタックの Outputs の AstroBucketName
CONTROL_DEPLOY_BUCKET=
# 親スタックの Outputs の DistributionId
CONTROL_DEPLOY_DISTRIBUTION_ID=
# 配信用の aws のプロファイル（comegin-prod-deploy。許可セット ComeginProdDeploy）
CONTROL_DEPLOY_AWS_PROFILE=

# ---- 本番の Mautic の読み取り（cycle-collect が campaign の項目の中身と、公開＝送信の開始の確認に使う。3 つともグループ） ----
# 参照専用ロール（mautic-prod-ro と同じ権限）の API 認証情報（OAuth2 client_credentials）を control-plane 用に別に発行する。エージェントには渡さない。
# 全部空なら campaign の項目は中身を埋めず・確かめず、理由を出す。一部だけなら起動時に例外
CONTROL_MAUTIC_URL=
CONTROL_MAUTIC_CLIENT_ID=
CONTROL_MAUTIC_CLIENT_SECRET=

# ---- 設定の状況（本番の監視アプリだけで有効にする。開発では false のまま。setup/00-setup-overview.md の P14） ----
# true のときだけ、下の 3 つ（絶対パス・ARN）と、上の AWS_REGION・SITE_URL が必須（欠けていれば起動時に例外。変数名だけを出す）。
# AWS_REGION を使うので、上の AWS のグループの規則で RUNLOG_BUCKET も必須。GITHUB_REPOSITORY は上の変数（空なら ComeGin/systematization-of-the-business-foundation）
CONTROL_SETUP_STATUS_ENABLED=false
# 読み取り専用の AWS の資格情報ファイル（絶対パス。本番は /home/<ユーザー>/.config/comegin/status-reader/aws-credentials。next-js-prod が書く）。値はここに書かない
CONTROL_STATUS_AWS_CREDENTIALS_FILE=
# 上のファイルの節の名前（空なら default。本番は default）
CONTROL_STATUS_AWS_PROFILE=
# 参照専用の GitHub トークンを 1 行で置いたファイル（絶対パス。本番は /home/<ユーザー>/.config/comegin/status-reader/github-token。next-js-prod が書く）。値はここに書かない
CONTROL_STATUS_GITHUB_TOKEN_FILE=
# 項目が action・warn になったときの知らせの送り先の SNS トピック（arn:aws:sns: で始まる）
CONTROL_STATUS_ALERT_TOPIC_ARN=
# 知らせのメールに載せる、監視アプリの画面の URL の根（空なら http://127.0.0.1:3200）
CONTROL_STATUS_LINK_BASE=
