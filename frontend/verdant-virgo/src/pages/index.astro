---
// 画面 1 トップ（/）。01-content-spec.md §4.1。Figma は Top / Desktop 1440（42:2）・Top / Mobile 390（42:5742）。
// ページは組み立てだけ。文言は site-content/top.ts（料金は pricing.ts）、部品は layout・marketing-ui・forms から読む。
// 1-2 ヘッダー・1-12 フッター・1-13 Cookie 同意バナー・チャットは BaseLayout が置く。
// 短い文が並ぶセクションには phrase（文節で折り返す）を付ける。Figma が U+2028 で避けている語中・数字と単位の間の改行を CSS で避ける（H-18）。
// 長い回答文が続く FAQ には付けない。
import {
  Accessibility,
  Coins,
  DoorOpen,
  FileText,
  Gift,
  Handshake,
  KeyRound,
  MapPin,
  Repeat,
  Ruler,
  Scale,
  Smartphone,
  Target,
  Unplug,
  UserRound,
  UserRoundCheck,
  Wallet,
  type LucideIcon,
} from 'lucide-react';
import { ArrowRight } from 'lucide-react';
import { Badge } from '@/components/ui/badge';
import { buttonVariants } from '@/components/ui/button';
import { SourceDlBlock } from '@/modules/source-dl';
import { AnnouncementBanner, BaseLayout } from '@/modules/layout';
import { Photo } from '@/modules/media';
import {
  BrokenHeading,
  CTABanner,
  CTAButton,
  FAQItem,
  IconCard,
  LogoCloud,
  Section,
  SectionHeading,
  ServiceCard,
  StatCard,
  Steps,
  TestimonialCard,
} from '@/modules/marketing-ui';
import { TAX_NOTE } from '@/modules/site-content/pricing';
import { SEO } from '@/modules/site-content/seo';
import { ctaHref, SERVICE_CARDS, SERVICE_ORDER, serviceCardPrices, type CtaCopy } from '@/modules/site-content/services';
import { TOP } from '@/modules/site-content/top';

const seo = SEO.top;
const from = Astro.url.pathname;

const hrefOf = (cta: CtaCopy) => ctaHref(cta, from);

// top.ts のアイコン名（Lucide の kebab-case）→ 部品
const ICONS: Record<string, LucideIcon> = {
  'user-round-check': UserRoundCheck,
  repeat: Repeat,
  coins: Coins,
  gift: Gift,
  scale: Scale,
  'file-text': FileText,
  unplug: Unplug,
  'user-round': UserRound,
  wallet: Wallet,
  'map-pin': MapPin,
  ruler: Ruler,
  'key-round': KeyRound,
  target: Target,
  handshake: Handshake,
  'door-open': DoorOpen,
  smartphone: Smartphone,
  accessibility: Accessibility,
};
const iconOf = (name: string) => {
  const icon = ICONS[name];
  if (!icon) throw new Error(`index.astro: アイコン「${name}」の対応がありません。`);
  return icon;
};

// 1-7 のサービスカード。金額・期間・備考は §2（pricing.ts）から引く
const serviceCards = SERVICE_ORDER.map((slug) => ({ card: SERVICE_CARDS[slug], ...serviceCardPrices(SERVICE_CARDS[slug]) }));

const { announcement, hero, philosophy, problems, promises, experience, loop, tools, services, cases, sourceDl, faq, banner } = TOP;
---

<BaseLayout title={seo.title} description={seo.description} noindex={seo.noindex} sourceDlOnPage>
  {/* 1-1 告知バナー */}
  <AnnouncementBanner slot="announcement" badge={announcement.badge} text={announcement.desktopBody} shortText={announcement.mobileBody}>
    <CTAButton
      slot="cta"
      ctaId={announcement.cta.ctaId}
      href={hrefOf(announcement.cta)}
      variant="link"
      size="sm"
      icon="arrow-right"
      iconPosition="end"
    >
      {announcement.cta.label}
    </CTAButton>
  </AnnouncementBanner>

  {/* 1-3 ヒーロー（上 Desktop 128px・Mobile 32px）。Mobile は 本文 → 画像枠 → ボタン の順に縦積み（§4.1 の 1-3 の D/M） */}
  <Section tone="subtle" class="phrase pt-8 md:pt-32">
    <div class="grid gap-4 md:grid-cols-[minmax(0,608fr)_minmax(0,480fr)] md:gap-x-16">
      <div class="flex flex-col items-start gap-4 md:self-end">
        <p class="type-small text-text-brand">{hero.tagline}</p>
        <BrokenHeading heading={hero.h1} level="h1" class="type-h1 text-text-heading" />
        <div class="type-body-lg text-text-body">
          {hero.body.map((sentence) => <p>{sentence}</p>)}
        </div>
      </div>
      {/* ヒーローの写真（4:3）。LCP になりうるので先に読む */}
      <Photo
        photo={hero.photo}
        sizes="(min-width: 768px) 480px, 100vw"
        loading="eager"
        fetchpriority="high"
        class="aspect-[4/3] w-full md:col-start-2 md:row-span-2 md:row-start-1 md:self-center"
      />
      <div class="flex flex-col items-start gap-4 md:self-start">
        <div class="flex w-full flex-col gap-4 md:w-auto md:flex-row md:items-center">
          <CTAButton ctaId={hero.primaryCta.ctaId} href={hrefOf(hero.primaryCta)} size="lg" fullWidth="mobile">
            {hero.primaryCta.label}
          </CTAButton>
          <CTAButton
            ctaId={hero.secondaryCta.ctaId}
            href={hrefOf(hero.secondaryCta)}
            variant="ghost"
            size="lg"
            icon="download"
            fullWidth="mobile"
          >
            {hero.secondaryCta.label}
          </CTAButton>
        </div>
        <p class="type-small text-text-muted">{hero.note}</p>
      </div>
    </div>
  </Section>

  {/* 1-4a 業務理念と、それを実現する 5つの方法 */}
  <Section labelledby="top-philosophy" class="phrase">
    <div class="flex flex-col gap-4">
      <p class="type-small text-text-brand">{philosophy.eyebrow}</p>
      <SectionHeading id="top-philosophy" title={philosophy.heading} lead={philosophy.lead} />
    </div>
    <div class="mt-8 md:mt-12 flex flex-col gap-4 md:gap-6">
      <div class="grid gap-4 md:gap-6 md:grid-cols-3">
        {philosophy.cards.slice(0, 3).map((card) => <IconCard icon={iconOf(card.icon)} title={card.title} body={card.body} />)}
      </div>
      <div class="grid gap-4 md:gap-6 md:grid-cols-2">
        {philosophy.cards.slice(3).map((card) => <IconCard icon={iconOf(card.icon)} title={card.title} body={card.body} />)}
      </div>
    </div>
  </Section>

  {/* 1-4b こんなことが起きていませんか */}
  <Section labelledby="top-problems" class="phrase">
    <SectionHeading id="top-problems" title={problems.heading} />
    <div class="mt-8 md:mt-12 grid gap-4 md:gap-6 md:grid-cols-3">
      {problems.cards.map((card) => <IconCard icon={iconOf(card.icon)} title={card.title} body={card.body} />)}
    </div>
  </Section>

  {/* 1-4c 選ばれる理由（ComeGin がお約束すること） */}
  <Section labelledby="top-promises" class="phrase">
    <SectionHeading id="top-promises" title={promises.heading} lead={promises.lead} />
    <div class="mt-8 md:mt-12 grid gap-4 md:gap-6 md:grid-cols-3">
      {
        promises.cards.map((card) => (
          <IconCard
            icon={iconOf(card.icon)}
            title={card.title}
            body={card.body}
            caption={'caption' in card && card.caption ? [...card.caption] : undefined}
          />
        ))
      }
    </div>
    <p class="type-small mt-8 md:mt-12 text-text-muted">{TAX_NOTE}</p>
  </Section>

  {/* 1-4d 体験の約束（2026-10-13 に新設。小見出しは 1-4a と同じ組み方） */}
  <Section labelledby="top-experience" class="phrase">
    <div class="flex flex-col gap-4">
      <p class="type-small text-text-brand">{experience.eyebrow}</p>
      <SectionHeading id="top-experience" title={experience.heading} lead={experience.lead} />
    </div>
    <div class="mt-8 md:mt-12 grid gap-4 md:gap-6 md:grid-cols-3">
      {experience.cards.map((card) => <IconCard icon={iconOf(card.icon)} title={card.title} body={card.body} />)}
    </div>
  </Section>

  {/* 1-5 仕組み */}
  <Section labelledby="top-loop" class="phrase">
    <div class="flex flex-col gap-4">
      <p class="type-body text-text-body">{loop.bridge}</p>
      <SectionHeading id="top-loop" title={loop.heading} lead={loop.lead} />
    </div>
    {/* 「問い合わせ」を語の途中で折り返さない（Q1 の指摘。auto-phrase でも Mobile で「問い｜合わせ」と切れたため。データの文字列は変えない） */}
    <Steps items={loop.steps.map((step) => ({ ...step, keepTogether: ['問い合わせ'] }))} columns={3} class="mt-8 md:mt-12" />
    <hr class="my-8 border-border md:my-12" />
    <div class="rounded-md border border-border bg-surface p-6 md:p-8">
      <h3 class="type-h3 text-text-heading">{loop.guardrails.heading}</h3>
      <ul class="type-body mt-4 list-disc pl-6 text-text-body">
        {loop.guardrails.items.map((item) => <li>{item}</li>)}
      </ul>
    </div>
  </Section>

  {/* 1-6 使うツール */}
  <Section labelledby="top-tools" class="phrase">
    <SectionHeading id="top-tools" title={tools.heading} lead={tools.lead} />
    {/* li を flex にして、行の高さ（28px）ではなくバッジの高さ 24px（Figma 42:6319。上下 4px）で並べる */}
    <ul class="mt-8 md:mt-12 flex flex-wrap gap-2">
      {
        tools.badges.map((name) => (
          <li class="flex">
            <Badge variant="outline" className="h-6 py-1">
              {name}
            </Badge>
          </li>
        ))
      }
    </ul>
  </Section>

  {/* 1-7 サービス */}
  <Section labelledby="top-services" class="phrase">
    <SectionHeading id="top-services" title={services.heading} lead={services.lead} />
    <div class="mt-8 md:mt-12 grid gap-4 md:gap-6 md:grid-cols-2">
      {
        serviceCards.map(({ card, prices, note }) => (
          <ServiceCard
            title={card.title}
            badge={card.badge ?? undefined}
            body={card.body}
            prices={prices}
            note={note}
            detailHref={card.detailLink.href}
            detailLabel={card.detailLink.label}
          >
            {card.sourceDlLinkLabel && (
              <CTAButton slot="sub-link" ctaId={services.sourceDlCtaId} href="#source-dl" variant="link" icon="download">
                {card.sourceDlLinkLabel}
              </CTAButton>
            )}
          </ServiceCard>
        ))
      }
    </div>
    <div class="mt-8 md:mt-12 flex flex-col items-start gap-3">
      <p class="type-small text-text-muted">{TAX_NOTE}</p>
      <a href={services.pricingLink.href} class={buttonVariants({ variant: 'link', size: 'default' })}>
        {services.pricingLink.label}
        <ArrowRight aria-hidden="true" data-icon="inline-end" />
      </a>
    </div>
  </Section>

  {/* 1-8 導入事例（ダミー） */}
  <Section labelledby="top-cases" class="phrase">
    <SectionHeading id="top-cases" title={cases.heading} lead={cases.lead} badge={cases.headingBadge} />
    <LogoCloud class="mt-8 md:mt-12" />
    <div class="mt-8 md:mt-12 grid gap-4 md:gap-6 md:grid-cols-3">
      {
        Array.from({ length: cases.testimonialCount }, () => (
          <TestimonialCard badge={cases.testimonial.badge} title={cases.testimonial.title} body={cases.testimonial.body} />
        ))
      }
    </div>
    <div class="mt-8 md:mt-12 grid gap-4 md:gap-6 md:grid-cols-3">
      {cases.stats.map((stat) => <StatCard label={stat.label} caption={stat.note} />)}
    </div>
  </Section>

  {/* 1-9 無料 DL ブロック（控えめ版。CTA ＝ zip のダウンロード ＋ 無料相談への遷移。部品が id="source-dl" を持つ） */}
  <Section>
    <SourceDlBlock
      ctaId={sourceDl.ctaId}
      title={sourceDl.copy.title}
      body={sourceDl.copy.body}
      buttonLabel={sourceDl.buttonLabel}
      note={sourceDl.note}
      repositoryLinkLabel={sourceDl.repositoryLinkLabel}
    />
  </Section>

  {/* 1-10 よくある質問（最初の 1 件だけ開く） */}
  <Section labelledby="top-faq">
    <SectionHeading id="top-faq" title={faq.heading} />
    <div class="mt-8 md:mt-12">
      {
        faq.items.map((item, i) => (
          <FAQItem question={item.question} answer={item.answer} open={i === TOP.faqDefaultOpenIndex} />
        ))
      }
    </div>
  </Section>

  {/* 1-11 CTA バナー（主 CTA） */}
  <Section>
    <CTABanner title={banner.title} body={banner.body}>
      <CTAButton slot="cta" ctaId={banner.cta.ctaId} href={hrefOf(banner.cta)} size="lg" fullWidth="mobile">
        {banner.cta.label}
      </CTAButton>
    </CTABanner>
  </Section>
</BaseLayout>
