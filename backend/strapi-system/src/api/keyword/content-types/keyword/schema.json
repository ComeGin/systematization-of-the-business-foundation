{
  "kind": "collectionType",
  "collectionName": "keywords",
  "info": {
    "singularName": "keyword",
    "pluralName": "keywords",
    "displayName": "Keyword",
    "description": "E-01 キーワード候補と検索意図（agent/keyword-researcher が候補を作り、R2 が採用する）"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "phrase": {
      "type": "string",
      "required": true,
      "unique": true
    },
    "monthly_volume": {
      "type": "integer",
      "min": 0
    },
    "adoption_status": {
      "type": "enumeration",
      "enum": ["candidate", "adopted", "skipped"],
      "default": "candidate",
      "required": true
    },
    "intent_code": {
      "type": "enumeration",
      "enum": ["latent", "semi_explicit", "explicit"]
    },
    "content_plans": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::content-plan.content-plan",
      "mappedBy": "keyword"
    },
    "articles": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::article.article"
    }
  }
}
