HOST=0.0.0.0
PORT=1337
APP_KEYS="toBeModified1,toBeModified2"
API_TOKEN_SALT=tobemodified
ADMIN_JWT_SECRET=tobemodified
TRANSFER_TOKEN_SALT=tobemodified
JWT_SECRET=tobemodified
ENCRYPTION_KEY=tobemodified

STRAPI_PLUGIN_I18N_INIT_LOCALE_CODE=ja-JP

# 本番（ALB が TLS を終端する ECS）では PUBLIC_URL と PROXY=true が必須。
# 渡さないと管理画面が Secure Cookie を発行できずログインできない。開発環境は空と false のままでよい。
PUBLIC_URL=
PROXY=false

# Database
# 開発環境は sqlite。本番は postgres（RDS for PostgreSQL の strapi データベース。DATABASE_SSL=true）。
# DATABASE_PASSWORD は本番では Secrets Manager から注入する（ECS の secrets）。
DATABASE_CLIENT=sqlite
DATABASE_HOST=
DATABASE_PORT=
DATABASE_NAME=
DATABASE_USERNAME=
DATABASE_PASSWORD=
DATABASE_SSL=false
# 証明書の検証。未設定なら true（config/database.ts）。**本番では false にしない。**
# 本番のイメージには RDS の CA 束が入っていて（Dockerfile の NODE_EXTRA_CA_CERTS）、検証つきでつなげる。
# false にしてよいのは、CA を持たない開発用の DB につなぐときだけ。
# DATABASE_SSL_REJECT_UNAUTHORIZED=false  # 設定しない（空にもしない。空文字は false と読まれる）
DATABASE_FILENAME=.tmp/data.db

# Upload (config/plugins.ts)
# UPLOAD_PROVIDER: local（既定。public/uploads）/ aws-s3（本番のメディアのバケット）。
# aws-s3 の認証は ECS のタスクロール。アクセスキーは置かない。バケットは公開しない（署名付き URL で配る）。
UPLOAD_PROVIDER=local
UPLOAD_S3_BUCKET=
UPLOAD_S3_REGION=

# PostHog (src/posthog.ts) - required outside production
# Project token: https://us.posthog.com/settings/project (starts with phc_)
POSTHOG_PROJECT_TOKEN=phc_tobemodified
POSTHOG_HOST=https://us.i.posthog.com
