# 本番の n8n（オンプレ。ADR-21）の設定
#
# このファイルは compose.yml と同じディレクトリに置く .env のひな形。.env は追跡しない（600）。
# 暗号化キーとランナーのトークンは dev/init-env.sh が生成する:
#   ./dev/init-env.sh
# 空のままにしておけば同スクリプトが値を作って書き込む（既に値がある項目は変更しない）。
# RDS のパスワードは人が入れる（スクリプトは作らない）。
#
# 開発環境の middleware/n8n/.env とは別のファイル・別のインスタンス（ポートも 5678 ではなく 5679/5680）。

# ===== Compose / イメージ =====
# n8n 本体と runners の両方に使う。両者のバージョンは必ず一致させること（開発環境の middleware/n8n/.env.example と同じ版に保つ）
# 更新するときは https://github.com/n8n-io/n8n/releases を確認する
N8N_VERSION=2.39.5
# 上のバージョンのダイジェスト（タグの付け替えに備えて固定する）。版を上げたら両方を変える。
# 値は `docker buildx imagetools inspect n8nio/n8n:<版>`・`… ghcr.io/n8n-io/runners:<版>` の Digest（2026-10-27 に 2.39.5 で取得）
N8N_DIGEST=sha256:cfa04788a34ae6f5d59d9086c5761315be2457a9608969553bd0add9a94959d1
N8N_RUNNERS_DIGEST=sha256:b16132aecf99c51aef1ef6ca8e0caf81223dad9d9c3bbbb4156b17d686c58f9d

# ===== n8n 本体 =====
# 保存済みの資格情報の暗号化キー。**一度作ったら変えない。**
# 変えると RDS（n8n データベース）に保存済みの資格情報（Mautic・Chatwoot の署名鍵、AWS のキーなど）を
# すべて復号できなくなる。データは RDS にあるのでボリュームを消しても残るが、このキーの控えが無いと復旧できない。
# 生成したら、.env とは別の場所（パスワードマネージャーなど）に控える。
N8N_ENCRYPTION_KEY=

GENERIC_TIMEZONE=Asia/Tokyo
TZ=Asia/Tokyo

# エディター・API・MCP のホスト側ポート（127.0.0.1 だけ。開発の n8n は 5678）
N8N_EDITOR_PORT_HOST=5679

# ===== Webhook の受け口（webhook-proxy）=====
# WireGuard のオンプレ側のアドレス。proxy はこのアドレスの 5680 だけに開く。
# wireguard/wg0.conf.example の Address と同じ値にする。Webhook の宛先は http://<この値>:5680/webhook/...
WG_ADDRESS=10.99.0.2

# proxy が /webhook/ を受け付ける送信元（空白区切りで複数可。IPv4 のアドレスか CIDR）。許可されない送信元は 404。
# EC2 が VPC からの通信を masquerade するので、本番は常に 10.99.0.1 だけ（既定）。
# Docker のブリッジ（172.16.0.0/12 など）は本番では足さない（同じマシンの別のコンテナから届いてしまう）。
# ローカルで試すときだけブリッジのアドレスを足し（例 "10.99.0.1 172.16.0.0/12"）、試したら戻す（README.md の「疎通の確かめ方」）。
WEBHOOK_ALLOWED_SOURCES=10.99.0.1

# ===== タスクランナー（external モード）=====
# n8n（ブローカー）と runners コンテナの共有シークレット
N8N_RUNNERS_AUTH_TOKEN=

# ===== RDS（PostgreSQL の n8n データベース。WireGuard 越し）=====
# エンドポイント（例: comegin-prod-xxxx.xxxxxxxx.ap-northeast-1.rds.amazonaws.com）。人が入れる
# RDS のエンドポイントは VPC の中のアドレスに解決される。TLS の検証はこのホスト名で行うので、IP アドレスで書かない
DB_POSTGRESDB_HOST=
DB_POSTGRESDB_PORT=5432
DB_POSTGRESDB_DATABASE=n8n
DB_POSTGRESDB_USER=n8n
# n8n ユーザーのパスワード。人が入れる（権限は n8n データベースだけに絞られている）。
# Secrets Manager の comegin/prod/n8n/DB_PASSWORD から取り出す（cloud/README.md の 4.8）
DB_POSTGRESDB_PASSWORD=
# 証明書の検証（DB_POSTGRESDB_SSL_REJECT_UNAUTHORIZED=true）と CA（DB_POSTGRESDB_SSL_CA_FILE）は compose.yml に固定してある。
# AWS の API のキー（SNS への発行用の IAM ユーザー）はここに置かない。n8n の資格情報として UI から入力する（RDS に暗号化されて保存される）。
# AWS の API のキーは、SNS への発行と CloudWatch へのハートビート（n8n-schedule-heartbeat。PutMetricData）の両方に同じ IAM ユーザーのものを使う。

# ===== 実行履歴の保持（DA-05 の 2 節。90 日）=====
# compose.yml に既定値を書いてあるので、変えたいときだけコメントを外す。MAX_AGE は時間（2160 = 90 日）。
# MAX_COUNT の n8n の既定（10000）は 90 日に届く前に消えうるため 50000 にしている（RDS の肥大の安全弁）。
# 出典: https://docs.n8n.io/deploy/host-n8n/configure-n8n/basic-configuration/use-environment-variables/executions
#EXECUTIONS_DATA_MAX_AGE=2160
#EXECUTIONS_DATA_PRUNE_MAX_COUNT=50000
