---
/**
 * ヘッダーの上の告知帯（01-content-spec.md §4.1 の 1-1、Figma の AnnouncementBanner）。閉じるボタンは付けない。
 * BaseLayout の slot="announcement" に置く。ランドマーク（aside）にはしない（名前の無い complementary が CTA バナーと重なるため。短い 1 行の告知で、ヘッダーの直前にあり見つけやすい）。
 * Desktop: 強調バッジ ＋ 本文 ＋ リンク。Mobile: バッジを省き、短い本文 ＋ リンク。
 * 本文は「…」で省かず折り返す（拡大・狭い幅でも全文を読めるように。WCAG 1.4.4・1.4.10）。
 * リンクは slot="cta" に CTAButton（variant="link"・icon="arrow-right"・iconPosition="end"）を置く。
 * 文言はすべて props で渡す（既定値を持たない。H-16）。
 */
import { Badge } from '@/components/ui/badge';

interface Props {
  /** Desktop のバッジ */
  badge: string;
  /** Desktop の本文 */
  text: string;
  /** Mobile の本文（1 行に収まる短い文） */
  shortText: string;
}

const { badge, text, shortText } = Astro.props;
---

<div class="border-b border-border bg-surface-subtle">
  <div class="site-container flex items-center justify-center gap-2 py-2 md:gap-3">
    <Badge variant="accent" className="hidden md:inline-flex">{badge}</Badge>
    <p class="type-ui-text phrase hidden text-text-body md:block md:min-w-0">{text}</p>
    {/* Mobile は短い本文（§4.1 の 1-1）。390px では 1 行に収まる長さで、幅が足りない・拡大したときは折り返す */}
    <p class="type-ui-text phrase min-w-0 text-text-body md:hidden">{shortText}</p>
    <div class="shrink-0"><slot name="cta" /></div>
  </div>
</div>
