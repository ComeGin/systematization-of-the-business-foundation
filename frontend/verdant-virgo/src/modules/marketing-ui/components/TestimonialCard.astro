---
/**
 * お客さまの声の枠（ダミー。トップ 1-8。Figma の TestimonialCard）。
 * 人名・社名・肩書き・星の数・顔写真を入れない。文言は仕様書（01-content-spec.md §4.1 の 1-8）から渡す。
 */
import { Badge } from '@/components/ui/badge';
import { cn } from '@/lib/utils';
import type { HeadingLevel } from '../lib/types';

interface Props {
  /** 枠の左上のバッジ（「準備中」） */
  badge: string;
  title: string;
  body: string;
  level?: HeadingLevel;
  class?: string;
}

const { badge, title, body, level = 'h3', class: className } = Astro.props;
const Heading = level;
---

<article class={cn('flex flex-col items-start gap-3 rounded-md border border-border bg-surface p-6', className)}>
  <Badge variant="outline">{badge}</Badge>
  <Heading class="type-card-title text-text-heading">{title}</Heading>
  <p class="type-small phrase text-text-muted">{body}</p>
</article>
