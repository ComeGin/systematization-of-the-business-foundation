              "leftValue": "={{ $('設定を読む').all().find(r => r.json.key === 'inventoryEnabled')?.json.value ?? 'false' }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              },
              "rightValue": "true"
            }
          ],
          "combinator": "and"
        }
      },
      "id": "fc9457af-dbbd-5b5b-aafe-2e368ca3d55d",
      "name": "棚卸しが有効か",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        96
      ],
      "notes": "ops_settings の inventoryEnabled が true のときだけ動く。行が無い・true 以外なら何もしない（安全側）。",
      "executeOnce": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('設定を読む').all().find(r => r.json.key === 'chatwootBaseUrl')?.json.value }}/api/v1/accounts/{{ $('設定を読む').all().find(r => r.json.key === 'chatwootAccountId')?.json.value }}/conversations",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "status",
              "value": "open"
            },
            {
              "name": "assignee_type",
              "value": "unassigned"
            },
            {
              "name": "sort_by",
              "value": "waiting_since_asc"
            }
          ]
        },
        "options": {
          "timeout": 20000
        }
      },
      "id": "0819820c-ffa4-5c29-ae56-9eaf4312ab04",
      "name": "未割り当ての会話を取る",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        96
      ],
      "notes": "Chatwoot の会話一覧（開いていて担当者がいない会話）。1 ページ 25 件固定。件数は応答の meta から取り、ページは進めない。display_id は応答の id。",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "name": "Chatwoot API（api_access_token）"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "includeOtherFields": false,
        "assignments": {
          "assignments": [
            {
              "id": "ok",
              "name": "ok",
              "type": "boolean",
              "value": "={{ !$('未割り当ての会話を取る').first().json.error && Array.isArray($('未割り当ての会話を取る').first().json.data?.payload) }}"
            },
            {
              "id": "unassigned",
              "name": "unassigned",
              "type": "number",
              "value": "={{ Number($('未割り当ての会話を取る').first().json.data?.meta?.unassigned_count ?? 0) }}"
            },
            {
              "id": "detail",
              "name": "detail",
              "type": "string",
              "value": "={{ (() => {\n  const u = $('未割り当ての会話を取る').first().json.data?.payload ?? [];\n  const nums = u.map(c => c.waiting_since).filter(s => s > 0);\n  const hours = nums.length ? Math.floor((Date.now() / 1000 - Math.min(...nums)) / 3600) : 0;\n  const total = Number($('未割り当ての会話を取る').first().json.data?.meta?.unassigned_count ?? 0);\n  const ids = u.slice(0, 10).map(c => '#' + c.id).join(' ');\n  return '未割り当て ' + total + ' 件／最も長い待ち ' + hours + ' 時間／未割り当ての会話 ' + (ids || 'なし') + (total > 10 ? ' ほか' : '');\n})() }}"
            }
          ]
        },
        "options": {}
      },
      "id": "7ae6d45f-b180-508c-a911-a309c9095b2f",
      "name": "集計する",
      "type": "n8n-nodes-base.set",
