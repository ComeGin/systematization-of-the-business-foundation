---
// 画面 6 無料相談（/contact）。01-content-spec.md §4.6。Figma は Contact / Desktop / 通常（42:132）・Contact / Mobile / 通常（42:3423）。
// 状態の派生（入力エラー・送信中・送信失敗・二重送信）はフォームの部品（forms の ContactFormBlock）が持つ。
// ページは組み立てだけ。文言は site-content/contact.ts（フォームの文言は forms モジュール）。
// 動き（B〈calm〉）: サイドの 3 枚の案内カードが画面に入るとき、下から静かに上がる（motion の Reveal）。フォームと導入には動きを付けない（入力の邪魔をしない）。
import { ArrowDown, MessageCircle } from 'lucide-react';
import { buttonVariants } from '@/components/ui/button';
import { cn } from '@/lib/utils';
import { ContactFormBlock } from '@/modules/forms';
import { BaseLayout, PageIntro } from '@/modules/layout';
import { DioramaStill } from '@/modules/diorama';
import { CTAButton, Section } from '@/modules/marketing-ui';
import { Reveal } from '@/modules/motion';
import { VT } from '@/modules/page-transition';
import { contact } from '@/modules/site-content/contact';
import { ctaDataAttributes } from '@/modules/site-content/cta';
import { SEO } from '@/modules/site-content/seo';
import InventoryCard from './_InventoryCard.astro';

const seo = SEO.contact;
const { hero, inventory, aside } = contact;
// ホームはパンくずの部品が先頭に足す
const breadcrumb = contact.breadcrumb.slice(1).map((crumb) => ({ ...crumb }));
---

<BaseLayout title={seo.title} description={seo.description} noindex={seo.noindex} breadcrumb={breadcrumb}>
  {/* 6-3 導入ヒーロー（本文は 2 段落） */}
  {/* h1 の id は相談フォームの名前（ContactFormBlock の labelledBy）が指す */}
  {/* h1 は vt-contact-title を静的に持つ（前のページで押した CTA ボタンから形がつながる。page-transition） */}
  {/* 2026-10-28: 媒体の枠に、基盤の模型の問い合わせ窓口の静止画（B は静止。DioramaStill） */}
  <PageIntro title={hero.h1} titleId="contact-heading" titleViewTransitionName={VT.contactTitle}>
    <DioramaStill slot="media" page="contact" />
    <div slot="body" class="type-body-lg phrase flex max-w-[720px] flex-col text-text-muted">
      {hero.body.map((paragraph) => <p>{paragraph.join('')}</p>)}
    </div>
  </PageIntro>

  {/* 6-3 の本文の下: 業務棚卸しの内容（Desktop 2 列 ×2 段、Mobile 1 列）と合計の 1 行 */}
  <Section class="pt-0 pb-0 md:pt-0 md:pb-0">
    <div class="grid gap-4 md:grid-cols-2 md:gap-8">
      {inventory.items.map((item) => <InventoryCard duration={item.duration} title={item.title} body={item.body} />)}
    </div>
    <p class="type-body mt-4 text-text-body">{inventory.total}</p>
  </Section>

  {/* 6-4 相談フォーム（左 2/3）と 6-5 サイドの案内（右 1/3）。Mobile はフォームを先に縦積み */}
  <Section class="phrase">
    <div class="grid gap-8 md:grid-cols-[minmax(0,736fr)_minmax(0,384fr)]">
      <div class="w-full max-w-[640px]">
        <ContactFormBlock labelledBy="contact-heading" />
      </div>

      <div class="flex flex-col gap-8">
        {/* カード 1 ご相談の流れ（6 段。体言止め） */}
        <Reveal as="section" aria-labelledby="contact-flow" class="flex flex-col gap-4 rounded-md border border-border bg-surface p-6">
          <h2 id="contact-flow" class="type-card-title text-text-heading">{aside.flow.heading}</h2>
          <ol class="flex flex-col gap-2">
            {
              aside.flow.steps.map((step, i) => (
                <li class="flex flex-col gap-2">
                  {i > 0 && (
                    <span aria-hidden="true" class="flex pl-2 text-text-muted">
                      <ArrowDown className="size-6" />
                    </span>
                  )}
                  <div class="flex items-start gap-4">
                    <span
                      aria-hidden="true"
                      class="type-label flex size-10 shrink-0 items-center justify-center rounded-full bg-surface-accent-subtle text-text-accent-subtle"
                    >
                      {i + 1}
                    </span>
                    <p class="type-label pt-2.5 text-text-heading">{step}</p>
                  </div>
                </li>
              ))
            }
          </ol>
          <p class="type-caption text-text-muted">{aside.flow.note}</p>
        </Reveal>

        {/* カード 2 チャット（§6.3 の #23）。同意の前は押すと同意バナーを再表示する（chat モジュールが data-chat-open を拾う。K3） */}
        <Reveal step={1} class="flex flex-col gap-2">
          <section aria-labelledby="contact-chat" class="flex flex-col gap-4 rounded-md border border-border bg-surface p-6">
            <div class="flex flex-col gap-3">
              <h2 id="contact-chat" class="type-card-title text-text-heading">{aside.chat.heading}</h2>
              <p class="type-body text-text-muted">{aside.chat.body}</p>
            </div>
            <button
              type="button"
              data-chat-open
              {...ctaDataAttributes('chat_contact_aside')}
              class={cn(buttonVariants({ variant: 'outline', size: 'sm' }), 'w-full')}
            >
              <MessageCircle aria-hidden="true" />
              {aside.chat.button}
            </button>
          </section>
          <p class="type-caption text-text-muted">{aside.chat.note}</p>
        </Reveal>

        {/* カード 3 まずは自分で試したい方へ（§6.3 の #24。副 CTA → /#source-dl） */}
        <Reveal as="section" step={2} aria-labelledby="contact-self" class="flex flex-col items-start gap-4 rounded-md border border-border bg-surface p-6">
          <div class="flex flex-col gap-3">
            <h2 id="contact-self" class="type-card-title text-text-heading">{aside.selfTry.heading}</h2>
            <p class="type-body text-text-muted">{aside.selfTry.body}</p>
          </div>
          <CTAButton ctaId="dl_contact_aside" href="/#source-dl" variant="link" size="sm" class="h-auto px-0">
            {aside.selfTry.link}
          </CTAButton>
        </Reveal>
      </div>
    </div>
  </Section>
</BaseLayout>
