---
/**
 * 全ページ共通の骨組み。<html lang="ja" data-motion-zone={motionZone}>、title・description・canonical・robots・OGP・ファビコン、
 * 本文へのスキップリンク、ヘッダー・パンくず・フッター、計測・同意・チャットの差し込み口を持つ。
 *
 * - title・description・noindex は site-content/seo.ts の値をそのまま渡す（01-content-spec.md §7）
 * - OGP 画像は全画面共通の 1 枚（public/og.png。§7.1）。og:title・og:description は title・description と同じ
 * - canonical はクエリを外した URL（/contact?cta=… も /contact にする。§7 の注）
 * - 計測・チャットは integrations の部品を body の末尾と head に置く（ページ側は何もしない）
 * - Cookie 同意バナーはスキップリンクの直後に置く（見た目は下端に固定のまま。DOM の順＝フォーカス順で、本文より前に操作できるようにする。WCAG 2.4.3）
 * - <main> は tabindex="-1"。スキップリンクで本文へフォーカスを移す
 * - 「ソースコードを無料 DL」の CTA の動き（zip のダウンロード ＋ 無料相談へ遷移）は source-dl の部品が body の末尾で全画面に効かせる
 * - motionZone は動きの区分。<html data-motion-zone> に出す（既定 calm。A=vivid のページと C=none のページだけが渡す）。none のページには PageTransition を置かない（JS も読まない）
 * - ページ移動の View Transitions の opt-in（@view-transition）と pagereveal の登録は、PageTransitionHead が head に出す。none のページには置かない（C へ入る・C から出る遷移が起きない）
 * - 告知帯（トップだけ）は slot="announcement"、ページ固有の head 要素（JSON-LD など）は slot="head"
 * - アバター（avatar の AvatarDock。画面の左下）は none 以外のページの body の末尾に置く（C のページには DOM も JS も出さない）
 */
import '@/styles/global.css';
import { AnalyticsHead, CtaTracking } from '@/modules/analytics';
import { AvatarDock } from '@/modules/avatar';
import { ChatLoader } from '@/modules/chat';
import { ConsentBanner } from '@/modules/consent';
import type { MotionZone } from '@/modules/motion';
import { PageTransition, PageTransitionHead } from '@/modules/page-transition';
import { SourceDlRedirect } from '@/modules/source-dl';
import type { BreadcrumbItem, BreadcrumbTone, HeaderCta } from '../lib/types';
import { HOME_CRUMB } from '../lib/types';
import Breadcrumb from './Breadcrumb.astro';
import SiteFooter from './SiteFooter.astro';
import SiteHeader from './SiteHeader.astro';

export interface Props {
  /** <title>（「… | ComeGin」まで含めた全体） */
  title: string;
  /** meta description。完了・404 は設定しない（§7） */
  description?: string;
  noindex?: boolean;
  /** ヘッダー・Sheet の「無料相談」の強さ。ブログ一覧・記事だけ outline */
  headerCta?: HeaderCta;
  /** パンくずのホームより後ろの段（最後が現在のページ）。トップ・404 では渡さない */
  breadcrumb?: BreadcrumbItem[];
  breadcrumbTone?: BreadcrumbTone;
  /** 既定は全画面共通の /og.png */
  ogImage?: string;
  ogType?: 'website' | 'article';
  /** ページの中に無料 DL ブロック（id="source-dl"）があるか。Sheet・フッターの DL のリンク先が変わる */
  sourceDlOnPage?: boolean;
  /** 動きの区分。vivid＝トップ・サービス（A）、none＝規約・ポリシー（C）、既定の calm＝ほか（B） */
  motionZone?: MotionZone;
}

const {
  title,
  description,
  noindex = false,
  headerCta = 'primary',
  breadcrumb,
  breadcrumbTone = 'subtle',
  ogImage = '/og.png',
  ogType = 'website',
  sourceDlOnPage = false,
  motionZone = 'calm',
} = Astro.props;

const canonical = new URL(Astro.url.pathname, Astro.site);
const ogImageUrl = new URL(ogImage, Astro.site);

// パンくずの構造化データ（Google の BreadcrumbList）。最後の段（現在のページ）は item を省く
const breadcrumbJsonLd = breadcrumb && {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [HOME_CRUMB, ...breadcrumb].map((crumb, i, all) => ({
    '@type': 'ListItem',
    position: i + 1,
    name: crumb.label,
    ...(i < all.length - 1 && crumb.href ? { item: new URL(crumb.href, Astro.site).href } : {}),
  })),
};
---

<!doctype html>
<html lang="ja" data-motion-zone={motionZone}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical.href} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" sizes="48x48" type="image/png" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="icon" href="/favicon-16.png" sizes="16x16" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" sizes="180x180" />
    <meta name="theme-color" content="#FFFFFF" />

    <meta property="og:site_name" content="ComeGin" />
    <meta property="og:locale" content="ja_JP" />
    <meta property="og:type" content={ogType} />
    <meta property="og:title" content={title} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:url" content={canonical.href} />
    <meta property="og:image" content={ogImageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="ComeGin" />
    <meta name="twitter:card" content="summary_large_image" />

    <meta name="generator" content={Astro.generator} />
    {motionZone !== 'none' && <PageTransitionHead />}
    {breadcrumbJsonLd && <script type="application/ld+json" set:html={JSON.stringify(breadcrumbJsonLd)} />}
    <slot name="head" />
    <AnalyticsHead />
  </head>
  <body class="flex min-h-dvh flex-col">
    {/* 見えたときの余白は ! 付きで当てる（focus:not-sr-only が padding を 0 に戻し、的が 70×20px になっていた。2.5.8 の 24px 以上） */}
    <a
      href="#main"
      class="type-label sr-only z-50 rounded-md bg-surface text-text-heading shadow-md focus:not-sr-only focus:fixed focus:top-2 focus:left-2 focus:px-4! focus:py-2!"
    >
      本文へ移動
    </a>
    <ConsentBanner />
    <slot name="announcement" />
    <SiteHeader headerCta={headerCta} sourceDlOnPage={sourceDlOnPage} motionZone={motionZone} />
    {breadcrumb && <Breadcrumb items={breadcrumb} tone={breadcrumbTone} />}
    <main id="main" tabindex="-1" class="flex-1">
      <slot />
    </main>
    <SiteFooter sourceDlOnPage={sourceDlOnPage} />
    <ChatLoader />
    <CtaTracking />
    <SourceDlRedirect />
    {motionZone !== 'none' && <PageTransition />}
    {motionZone !== 'none' && <AvatarDock zone={motionZone} />}
  </body>
</html>
