---
/**
 * パンくず（01-content-spec.md §1.5）。先頭の「ホーム」は自動で足す。トップと 404 には置かない。
 * 現在のページ（最後の段）はリンクにしない。Mobile は 1 行に収め、長い題名は「…」で省略する。
 * 見た目は Figma の PageIntro の中の Breadcrumb（UI/Text 14px、リンク role/text-muted、現在のページ role/text-body、区切り chevron-right 14px）。
 * リンクには下線を付ける（Figma の kit は下線なし。押せる文字は下線で示す規則に合わせた）。
 */
import { ChevronRight } from 'lucide-react';
import { cn } from '@/lib/utils';
import { HOME_CRUMB, type BreadcrumbItem, type BreadcrumbTone } from '../lib/types';

interface Props {
  /** ホームより後ろの段。最後の段が現在のページ */
  items: BreadcrumbItem[];
  tone?: BreadcrumbTone;
}

const { items, tone = 'subtle' } = Astro.props;
const crumbs: BreadcrumbItem[] = [HOME_CRUMB, ...items];
---

<nav aria-label="パンくずリスト" class={cn(tone === 'subtle' ? 'bg-surface-subtle' : 'bg-surface', 'pt-4 md:pt-6')}>
  <ol class="site-container type-ui-text flex flex-nowrap items-center gap-1 text-text-muted md:flex-wrap">
    {
      crumbs.map((crumb, i) => {
        const isLast = i === crumbs.length - 1;
        return (
          <>
            {i > 0 && (
              <li role="presentation" aria-hidden="true" class="shrink-0">
                <ChevronRight className="size-3.5" />
              </li>
            )}
            <li class={cn('inline-flex', isLast ? 'min-w-0' : 'shrink-0')}>
              {isLast || !crumb.href ? (
                <span aria-current={isLast ? 'page' : undefined} class={cn('text-text-body', isLast && 'truncate')}>
                  {crumb.label}
                </span>
              ) : (
                <a href={crumb.href} class="underline hover:text-text-body">
                  {crumb.label}
                </a>
              )}
            </li>
          </>
        );
      })
    }
  </ol>
</nav>
