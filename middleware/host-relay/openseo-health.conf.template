# OpenSEO の /api/health だけを、docker0 のアドレスで中継する（nginx。開発環境だけ）。
#
# OpenSEO は AUTH_MODE=local_noauth（認証なし）で、UI と /mcp（DataForSEO の費用が出るツールを含む）が同じポートにある。
# socat でポートごと中継すると、同じホストのどのコンテナからも OpenSEO の全部が使えてしまう。
# ops-monitor（n8n。TA-05 の項目 9）が要るのは GET /api/health だけなので、それ以外は固定の短い本文の 404 にする。
# このファイルは nginx 公式イメージの templates 機能（起動時に envsubst を通す）で conf.d/default.conf になる。
# 置き換えるのは ${RELAY_BIND}（compose.yml が渡す）だけ。

server {
    listen ${RELAY_BIND}:3001 default_server;
    server_name _;
    server_tokens off;
    # 404 の本文は固定の 1 行（空だと nginx が既定のエラーページを返してしまう）
    default_type text/plain;

    client_max_body_size 1k;
    client_body_timeout 5s;
    client_header_timeout 5s;

    location = /api/health {
        if ($request_method != GET) {
            return 404 'not found';
        }
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Connection "";
        # OpenSEO は Host ヘッダーを見て、知らない名前（host.docker.internal）を 403 にする。上流にはループバックの名前で渡す
        proxy_set_header Host 127.0.0.1:3001;
        proxy_connect_timeout 3s;
        proxy_read_timeout 10s;
    }

    location / {
        return 404 'not found';
    }
}
