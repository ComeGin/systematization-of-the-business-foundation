---
/**
 * カードの汎用部品（Figma の IconCard。トップ 1-4・会社概要 5-4・メンバー 5-7・完了 6-1・無料相談 6-5・記事 8-7 の著者など）。
 * 上から 小さい画像枠（avatar。96 角）→ 横いっぱいの画像枠（image）→ アイコン枠 → 見出し → 本文 → 出典（caption）→ slot="actions"。
 * アイコンは lucide-react の部品を渡す（icon={FileText}）。文言の既定値は持たない（H-16）。
 * 本文にリンクなどを含めるときは slot="body" を使う（body は省く）。
 * 画像があるときは slot="avatar"（96 角の枠の中身）に渡す。無ければ「画像（準備中）」の枠を出す。
 * data-* 属性は根の article に渡す（A のページの GlowGrid が data-glow-card を付ける。文言・見た目は変わらない）。
 */
import type { LucideIcon } from 'lucide-react';
import { cn } from '@/lib/utils';
import type { HeadingLevel } from '../lib/types';

interface Props {
  title: string;
  body?: string;
  /** 出典・注記（Caption・role/text-muted）。行ごとに分けて渡すと改行される */
  caption?: string | string[];
  icon?: LucideIcon;
  /** 96 角の小さい画像枠（著者カード） */
  avatar?: boolean;
  /** 横いっぱいの画像枠（メンバーカード） */
  image?: boolean;
  level?: HeadingLevel;
  class?: string;
  /** 根の article に渡す data-*（例: data-glow-card） */
  [dataAttribute: `data-${string}`]: string | boolean | undefined;
}

const { title, body, caption, icon: Icon, avatar = false, image = false, level = 'h3', class: className, ...attrs } = Astro.props;
const Heading = level;
const hasAvatar = Astro.slots.has('avatar');
const captionLines = caption === undefined ? [] : Array.isArray(caption) ? caption : [caption];
---

<article class={cn('not-typeset flex flex-col items-start gap-4 rounded-md border border-border bg-surface p-6', className)} {...attrs}>
  {
    avatar && hasAvatar && (
      <div class="size-24 shrink-0 overflow-hidden rounded-md">
        <slot name="avatar" />
      </div>
    )
  }
  {
    avatar && !hasAvatar && (
      <div class="type-caption flex size-24 flex-col items-center justify-center rounded-md border border-dashed border-border bg-surface-subtle p-4 text-center text-text-body">
        <span>画像</span>
        <span>（準備中）</span>
      </div>
    )
  }
  {
    image && (
      <div class="type-ui-text flex h-[180px] w-full items-center justify-center rounded-md border border-dashed border-border bg-surface-subtle p-4 text-text-body">
        画像（準備中）
      </div>
    )
  }
  {
    Icon && (
      <div class="flex size-10 items-center justify-center rounded-md bg-surface-accent-subtle text-text-accent-subtle">
        <Icon className="size-5" aria-hidden="true" />
      </div>
    )
  }
  <div class="flex w-full flex-col gap-3">
    <Heading class="type-card-title text-text-heading">{title}</Heading>
    {body && <p class="type-body phrase text-text-muted">{body}</p>}
    <slot name="body" />
    {
      captionLines.length > 0 && (
        <p class="type-caption phrase text-text-muted">
          {captionLines.map((line) => (
            <span class="block">{line}</span>
          ))}
        </p>
      )
    }
  </div>
  <slot name="actions" />
</article>
