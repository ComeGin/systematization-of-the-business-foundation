---
// 法務の本文のまとまり（段落・箇条書き・表・小見出し h3）を順に描く。間隔は置く側（flex の gap）が決める。
// 太字は仕様どおり出す（Figma には出していない。03-handoff §0.3）。法務の長文なので phrase は当てない
import type { LegalBlock } from '../types';
import LegalList from './LegalList.astro';
import LegalTable from './LegalTable.astro';
import RichTextView from './RichTextView.astro';

interface Props {
  blocks: readonly LegalBlock[];
}

const { blocks } = Astro.props;
---

{
  blocks.map((block) => {
    switch (block.kind) {
      case 'paragraph':
        return (
          <p class="type-body text-text-body">
            <RichTextView text={block.content} />
          </p>
        );
      case 'list':
        return <LegalList items={block.items} />;
      case 'table':
        return <LegalTable table={block.table} />;
      case 'subheading':
        return <h3 class="type-h3 text-text-heading">{block.text}</h3>;
    }
  })
}
