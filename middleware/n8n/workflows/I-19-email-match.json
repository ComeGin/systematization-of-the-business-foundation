{
  "name": "I-19 Chatwoot と Mautic の email 突合",
  "nodes": [
    {
      "parameters": {
        "inputSource": "workflowInputs",
        "workflowInputs": {
          "values": [
            {
              "name": "chatwootContactId",
              "type": "number"
            },
            {
              "name": "displayId",
              "type": "number"
            },
            {
              "name": "email",
              "type": "string"
            }
          ]
        }
      },
      "id": "1b27b812-0578-52e0-9a6d-a1f9a9a251fb",
      "name": "サブワークフローの入力",
      "type": "n8n-nodes-base.executeWorkflowTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose"
          },
          "conditions": [
            {
              "id": "454b1311-31ed-5c0b-8f2e-29d4282c8697",
              "leftValue": "={{ $json.email }}",
              "operator": {
                "type": "string",
                "operation": "notEmpty",
                "singleValue": true
              }
            },
            {
              "id": "3d729c07-f82f-5df3-a804-8b6318f90e43",
              "leftValue": "={{ $json.chatwootContactId }}",
              "operator": {
                "type": "number",
                "operation": "gt"
              },
              "rightValue": 0
            }
          ],
          "combinator": "and"
        }
      },
      "id": "58106068-ab48-52c0-abf0-f451e586789c",
      "name": "突合できる入力か",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        224,
        100
      ],
      "notes": "email が空、または Chatwoot のコンタクト ID が無いときは何もしない（email が空のまま検索すると Mautic の全件に当たるため）。"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "get",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "ops_settings"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "key",
              "condition": "eq",
              "keyValue": "mauticBaseUrl"
            }
          ]
        },
        "returnAll": false,
        "limit": 1
      },
      "id": "c0a25e07-6d25-5df7-8750-8848e2b5b320",
      "name": "Mautic の URL を読む",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        448,
        100
      ],
      "notes": "ops_settings の mauticBaseUrl（開発は http://host.docker.internal:8000、本番は https://mkt.comegin.com）。",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "method": "GET",
        "url": "={{ $('Mautic の URL を読む').first().json.value }}/api/contacts",
        "authentication": "genericCredentialType",
        "genericAuthType": "oAuth2Api",
        "sendQuery": true,
        "specifyQuery": "keypair",
        "queryParameters": {
          "parameters": [
            {
              "name": "search",
              "value": "={{ 'email:' + $('サブワークフローの入力').first().json.email }}"
            },
            {
              "name": "limit",
              "value": "10"
            }
          ]
        },
        "options": {
          "timeout": 30000
        }
      },
      "id": "f3e3091a-4ca2-5ce8-85c2-2b2f203f7827",
      "name": "Mautic でメールアドレスを検索",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.5,
      "position": [
        672,
        100
      ],
      "notes": "Mautic API は OAuth2 client_credentials（mautic-mcp と同じ方式）。タイムアウトは DD-01 7.2 の 30 秒。order_by は指定しない（不正な値が 500 の主因）。",
      "retryOnFail": true,
      "maxTries": 2,
      "waitBetweenTries": 3000,
      "credentials": {
        "oAuth2Api": {
          "name": "Mautic API（client_credentials）"
        }
      }
    },
    {
      "parameters": {
        "mode": "manual",
        "assignments": {
          "assignments": [
            {
              "id": "matchedIds",
              "name": "matchedIds",
              "type": "array",
              "value": "={{ Object.values($json.contacts ?? {})\n  .filter(c => String(c.fields?.core?.email?.value ?? '').trim().toLowerCase() === $('サブワークフローの入力').first().json.email)\n  .map(c => c.id) }}"
            }
          ]
        },
        "includeOtherFields": false,
        "options": {}
      },
      "id": "d1c260db-7571-5577-8a7b-de0cbd8c5ce1",
      "name": "lower(email) の完全一致だけを残す",
      "type": "n8n-nodes-base.set",
      "typeVersion": 3.5,
      "position": [
        896,
        100
      ],
      "notes": "Mautic の検索結果は部分一致・あいまい一致を含みうるため、lower(email) の完全一致だけを数える。部分一致・あいまい一致は行わない（誤った統合は不可逆。DD-04 7.1）。"
    },
    {
      "parameters": {
        "resource": "row",
        "operation": "upsert",
        "dataTableId": {
          "__rl": true,
          "mode": "name",
          "value": "contact_link"
        },
        "matchType": "allConditions",
        "filters": {
          "conditions": [
            {
              "keyName": "chatwootContactId",
              "condition": "eq",
              "keyValue": "={{ $('サブワークフローの入力').first().json.chatwootContactId }}"
            }
          ]
        },
        "columns": {
          "mappingMode": "defineBelow",
          "value": {
            "chatwootContactId": "={{ $('サブワークフローの入力').first().json.chatwootContactId }}",
            "displayId": "={{ $('サブワークフローの入力').first().json.displayId }}",
            "status": "={{ $json.matchedIds.length === 1 ? 'matched' : ($json.matchedIds.length === 0 ? 'unmatched' : 'ambiguous') }}",
            "mauticContactId": "={{ $json.matchedIds.length === 1 ? $json.matchedIds[0] : 0 }}",
            "matchCount": "={{ $json.matchedIds.length }}",
            "checkedAt": "={{ $now.toISO() }}"
          },
          "schema": [
            {
              "id": "chatwootContactId",
              "displayName": "chatwootContactId",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true
            },
            {
              "id": "displayId",
              "displayName": "displayId",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true
            },
            {
              "id": "status",
              "displayName": "status",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            },
            {
              "id": "mauticContactId",
              "displayName": "mauticContactId",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true
            },
            {
              "id": "matchCount",
              "displayName": "matchCount",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "number",
              "canBeUsedToMatch": true
            },
            {
              "id": "checkedAt",
              "displayName": "checkedAt",
              "required": false,
              "defaultMatch": false,
              "display": true,
              "type": "string",
              "canBeUsedToMatch": true
            }
          ]
        }
      },
      "id": "c53ec08f-7e00-55bf-ab11-04a222a5551f",
      "name": "対応付けを記録",
      "type": "n8n-nodes-base.dataTable",
      "typeVersion": 1.1,
      "position": [
        1120,
        100
      ],
      "notes": "対応付けを記録するところまで。chatwoot_merge_contacts は呼ばない（統合は人間の判断。DD-04 7.2）。一致が 0 件なら unmatched、2 件以上なら ambiguous（人間に返す）。email は記録しない。"
    }
  ],
  "connections": {
    "サブワークフローの入力": {
