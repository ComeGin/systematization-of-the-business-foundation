---
/**
 * 実績の数値のダミーカード（Figma の StatCard）。値は必ず「—」（架空の数値を入れない）ので props に持たない。
 * 複数枚で出典が 1 つのときは caption を省き、カードの外に Caption を 1 本置く。
 */
import { cn } from '@/lib/utils';

interface Props {
  label: string;
  caption?: string;
  class?: string;
}

const { label, caption, class: className } = Astro.props;
---

<div class={cn('flex flex-col gap-1 rounded-md border border-border bg-surface p-6', className)}>
  <p class="type-label phrase text-text-muted">{label}</p>
  <p class="type-price text-text-heading">—</p>
  {caption && <p class="type-caption phrase text-text-muted">{caption}</p>}
</div>
