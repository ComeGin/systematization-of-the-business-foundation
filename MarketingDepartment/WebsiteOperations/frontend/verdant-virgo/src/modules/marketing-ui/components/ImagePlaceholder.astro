---
/**
 * 画像を使わない方針の代わりの枠（Figma の ImagePlaceholder）。破線 role/border・地 role/surface-subtle・角丸 8px。
 * 大きさは置いた先で決める（class で aspect-[4/3]・h-[360px] など）。
 * 文言は label（「画像（準備中）：ループの図」「ロゴ（準備中）」など。仕様書から写す）。
 */
import { cn } from '@/lib/utils';

interface Props {
  label: string;
  class?: string;
}

const { label, class: className } = Astro.props;
---

<div
  class={cn(
    'not-typeset flex items-center justify-center rounded-md border border-dashed border-border bg-surface-subtle p-4 text-center',
    className,
  )}
>
  <p class="type-ui-text text-text-body">{label}</p>
</div>
