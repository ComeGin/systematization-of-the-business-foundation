---
/**
 * ページのセクションの外枠。上下の余白は Desktop 96px・Mobile 64px（03-handoff.md §4）。
 * 中身の幅は content（1152）／ article（720）／ form（640）。地は役割トークン（surface ／ subtle ／ brand-strong）。
 * ヒーローの上 128px など、余白を変えるときは class で上書きする（例 class="md:pt-32"）。
 */
import { cn } from '@/lib/utils';
import type { SectionTone, SectionWidth } from '../lib/types';

interface Props {
  id?: string;
  tone?: SectionTone;
  width?: SectionWidth;
  /** aria-labelledby に渡す見出しの id */
  labelledby?: string;
  class?: string;
  /** 中身の枠（幅を決める div）に足すクラス */
  innerClass?: string;
}

const { id, tone = 'surface', width = 'content', labelledby, class: className, innerClass } = Astro.props;

const toneClass: Record<SectionTone, string> = {
  surface: 'bg-surface',
  subtle: 'bg-surface-subtle',
  'brand-strong': 'bg-surface-brand-strong text-text-inverse',
};
const widthClass: Record<SectionWidth, string> = {
  content: 'site-container',
  article: 'site-container-article',
  form: 'site-container-form',
};
---

<section id={id} aria-labelledby={labelledby} class={cn('py-16 md:py-24', toneClass[tone], className)}>
  <div class={cn(widthClass[width], innerClass)}>
    <slot />
  </div>
</section>
