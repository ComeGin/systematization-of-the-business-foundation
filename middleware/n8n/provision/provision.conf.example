# middleware/n8n/provision の設定（雛形）。実体は ~/.config/comegin/n8n-provision/<dev|prod>.conf に写して書く（chmod 600）。
# 秘密値はこのファイル（雛形）に書かない。値が空の行は、provision.mjs の既定値（--target ごと）が使われる。
#
#   mkdir -p ~/.config/comegin/n8n-provision && chmod 700 ~/.config/comegin/n8n-provision
#   cp provision.conf.example ~/.config/comegin/n8n-provision/dev.conf && chmod 600 ~/.config/comegin/n8n-provision/dev.conf

# ---- n8n（必須） ----
# n8n の画面の Settings → n8n API → Create an API key で作ったキー
N8N_API_KEY=
# 既定: dev は http://127.0.0.1:5678、prod は http://127.0.0.1:5679
N8N_BASE_URL=

# ---- Mautic（必須） ----
# Mautic の API 資格情報（Settings → API Credentials。OAuth 2、client_credentials）。
# このスクリプトが Webhook を作るのと、n8n の I-19 が Mautic を検索するのに使う（mautic-mcp と同じクライアントでよい）
MAUTIC_CLIENT_ID=
MAUTIC_CLIENT_SECRET=
# このスクリプト（ホスト）から見た Mautic。既定: dev は http://127.0.0.1:8000、prod は https://mkt.comegin.com
MAUTIC_API_URL=
# n8n（コンテナ）から見た Mautic。既定: dev は http://host.docker.internal:8000（middleware/host-relay の中継）、prod は https://mkt.comegin.com
MAUTIC_URL_FROM_N8N=
# Mautic の Webhook の送り先。既定: dev は http://127.0.0.1:5678/webhook/mautic-event、prod は http://10.99.0.2:5680/webhook/mautic-event
MAUTIC_WEBHOOK_TARGET=

# ---- Chatwoot（必須） ----
# Chatwoot の**管理者（Administrator）**のアクセストークン（プロフィールの設定 → Access Token）。Webhook の作成には管理者の権限が要る
CHATWOOT_API_ACCESS_TOKEN=
# アカウントの ID（ブラウザの URL の /app/accounts/<ここ>/ の数字）
CHATWOOT_ACCOUNT_ID=
# このスクリプト（ホスト）から見た Chatwoot。既定: dev は http://127.0.0.1:3100、prod は https://chat.comegin.com
CHATWOOT_API_URL=
# n8n（コンテナ）から見た Chatwoot（週次の棚卸しが API を呼ぶ）。既定: dev は http://host.docker.internal:3100（middleware/host-relay の中継）、prod は https://chat.comegin.com
CHATWOOT_URL_FROM_N8N=
# 週次の棚卸し（n8n の資格情報「Chatwoot API（api_access_token）」）に入れるトークン。任意。
# 棚卸しに要るのは会話の一覧の読み取りだけなので、専用のユーザー（エージェントの権限）のトークンを発行して書くことを勧める。
# 空なら、上の CHATWOOT_API_ACCESS_TOKEN（管理者）で代用する（本番では警告が出る）
CHATWOOT_N8N_API_TOKEN=
# Chatwoot の Webhook の送り先。既定: dev は http://host.docker.internal:5678/webhook/chatwoot-event（中継）、prod は http://10.99.0.2:5680/webhook/chatwoot-event
CHATWOOT_WEBHOOK_TARGET=

# ---- 開発環境だけ（--target dev） ----
# 通知の送り先の MailHog（Mautic の MailHog の SMTP）。既定: host.docker.internal と 1025（中継）
SMTP_HOST=
SMTP_PORT=

# ---- 本番だけ（--target prod） ----
# IAM ユーザー comegin-prod-onprem-n8n-sns のアクセスキー（cloud/README.md の 4.5 で発行）
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# 既定 ap-northeast-1
AWS_REGION=
# SAM の親スタックの出力 LeadAlertTopicArn・OpsAlertTopicArn
SNS_TOPIC_ARN_LEAD=
SNS_TOPIC_ARN_OPS=
