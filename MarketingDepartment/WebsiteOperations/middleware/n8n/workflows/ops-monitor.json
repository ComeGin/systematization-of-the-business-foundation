      "name": "sandbox-tls の証明書を読む",
      "type": "n8n-nodes-base.readWriteFile",
      "typeVersion": 1.1,
      "position": [
        672,
        224
      ],
      "notes": "compose.yml が sandbox-tls ボリュームの public/（公開部分の *.crt だけ）を /home/node/.n8n-files/sandbox-tls に読み取り専用でマウントしている。n8n 2.0 以降、このノードは既定で ~/.n8n-files の下しか読めない。秘密鍵は見えない。読めないときは次のノードで ng にする。",
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "operation": "text",
        "destinationKey": "pem"
      },
      "id": "59e22a0a-ee17-5077-a902-c89b11f68704",
      "name": "証明書を文字列にする",
      "type": "n8n-nodes-base.extractFromFile",
      "typeVersion": 1.1,
      "position": [
        896,
        224
      ],
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// sandbox-tls の証明書（PEM）から期限（notAfter）を取り出し、一番近い期限までの日数を返す。\n// 読めた証明書が 0 件なら count: 0（次のノードで ng にする）。\nconst readNotAfter = (pem) => {\n  const der = Buffer.from(String(pem).replace(/-----[^-]+-----/g, '').replace(/\\s+/g, ''), 'base64');\n  const time = (i) => {\n    const tag = der[i];\n    const len = der[i + 1];\n    const s = der.toString('latin1', i + 2, i + 2 + len);\n    let m = null;\n    let year = 0;\n    if (tag === 0x17 && len === 0x0d) {\n      m = /^(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})Z$/.exec(s);\n      if (m) year = Number(m[1]) >= 50 ? 1900 + Number(m[1]) : 2000 + Number(m[1]);\n    } else if (tag === 0x18 && len === 0x0f) {\n      m = /^(\\d{4})(\\d{2})(\\d{2})(\\d{2})(\\d{2})(\\d{2})Z$/.exec(s);\n      if (m) year = Number(m[1]);\n    }\n    if (!m) return null;\n    return { end: i + 2 + len, ms: Date.UTC(year, Number(m[2]) - 1, Number(m[3]), Number(m[4]), Number(m[5]), Number(m[6])) };\n  };\n  for (let i = 0; i < der.length - 4; i++) {\n    const notBefore = time(i);\n    if (!notBefore) continue;\n    const notAfter = time(notBefore.end);\n    if (notAfter) return notAfter.ms;\n  }\n  return null;\n};\n\nconst expiries = $input.all()\n  .map((item) => item.json.pem)\n  .filter(Boolean)\n  .map(readNotAfter)\n  .filter((ms) => ms !== null);\n\nif (expiries.length === 0) return [{ json: { count: 0, daysLeft: null, notAfter: '' } }];\n\nconst earliest = Math.min(...expiries);\nreturn [\n  {\n    json: {\n      count: expiries.length,\n      daysLeft: Math.floor((earliest - Date.now()) / 86400000),\n      // JST の日付で表示する\n      notAfter: new Date(earliest + 9 * 3600 * 1000).toISOString().slice(0, 10),\n    },\n  },\n];\n"
      },
      "id": "5e5bb120-a18d-5138-a04c-d7a212621eba",
      "name": "期限が最も近い証明書の残り日数",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1120,
        224
      ],
      "notes": "X.509 の Validity は SEQUENCE { notBefore, notAfter }。UTCTime（0x17 0x0D）か GeneralizedTime（0x18 0x0F）が 2 つ連続する所の 2 つ目が期限。式やほかのノードでは DER を読めないため Code を使う。require を使わず Buffer だけ。"
    },
