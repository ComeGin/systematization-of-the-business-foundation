---
// 画面 7 ブログ一覧の 2 ページ目以降（/blog/page/<n>。すべての記事）。1 ページ目は /blog。
// title は「ブログ（Nページ目）｜…」、description は 1 ページ目と同じ、canonical はページ自身（2026-10-09 リード判断）。
import type { GetStaticPaths } from 'astro';
import { getAllArticles, paginate, type Article } from '@/modules/blog';
import { blogIndexSeo } from '@/modules/site-content/seo';
import BlogListing from '../_BlogListing.astro';

export const getStaticPaths = (async () => {
  const pages = paginate(await getAllArticles());
  return pages.slice(1).map((articles, i) => ({
    params: { page: String(i + 2) },
    props: { articles, page: i + 2, totalPages: pages.length },
  }));
}) satisfies GetStaticPaths;

interface Props {
  articles: Article[];
  page: number;
  totalPages: number;
}

const { articles, page, totalPages } = Astro.props;
---

<BlogListing seo={blogIndexSeo(page)} articles={articles} page={page} totalPages={totalPages} />
