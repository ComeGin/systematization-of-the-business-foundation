---
// 画面 7 ブログ一覧の 1 ページ目（/blog。すべての記事）。組み立ては _BlogListing.astro。
import { getAllArticles, paginate } from '@/modules/blog';
import { blogIndexSeo } from '@/modules/site-content/seo';
import BlogListing from './_BlogListing.astro';

const pages = paginate(await getAllArticles());
---

<BlogListing seo={blogIndexSeo(1)} articles={pages[0]} page={1} totalPages={pages.length} />
